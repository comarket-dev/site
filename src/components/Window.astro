---
/* The hero's product shot: Comarket's own app in a browser window, as each side would see it. Brands: their sales
   from creators. Creators: their earnings. Example numbers, labelled; no buyer is ever shown (no names, emails or
   cards: a sale is "New customer" and a plan).

   The window's body is a Blender render (design/window/build_window.py, finish.py): a rounded slab with its edge and
   its shadow on the page. The live HTML screen is drawn at a fixed size and mapped onto the render's screen face by
   one matrix3d (src/lib/homography.ts), and the whole piece scales with its box (--k, from the box's width), so it
   holds its shape at any size with no script and no WebGL. Wide (desktop) and narrow (phones) are two renders.

   --ww (set by the caller) is the screen's width on the page; the render and its shadow reach past it.
   Names follow the product's spec (platform-seed: apps/app at app.comarket.si; each side sees its sales and totals,
   with no billing states). */
import BrandMark from './examples/BrandMark.astro';
import meta from '../../public/assets/window/window.json';
import { matrix3d } from '../lib/homography';

interface Props {
  side: 'brands' | 'creators';
  label: string;
}
const { side, label } = Astro.props;
const brand = side === 'brands';

type Shape = { w: number; h: number; units: [number, number]; corners: [number, number][] };
const shape = (s: Shape) => {
  const [tl, tr, br, bl] = s.corners as [[number, number], [number, number], [number, number], [number, number]];
  const span = tr[0] - tl[0];
  return [
    `--iw:${s.w}px`,
    `--ih:${s.h}px`,
    `--sw:${s.units[0]}px`,
    `--sh:${s.units[1]}px`,
    `--span:${(span / s.w).toFixed(5)}`,
    `--ox:${(tl[0] / s.w).toFixed(5)}`,
    `--oy:${(tl[1] / s.w).toFixed(5)}`,
    `--m:${matrix3d(s.units[0], s.units[1], [tl, tr, br, bl])}`,
  ].join(';');
};
const wide = shape(meta.wide as Shape);
const narrow = shape(meta.narrow as Shape);

type Row = { mark?: 'fernwood' | 'tallyhawk' | 'quietly' | 'pagewell'; ava?: string; t: string; s: string; amt: string; st: 'held' | 'ok' | 'no'; ago?: string };
const rows: Row[] = brand
  ? [
      { ava: 'sarah', t: 'Sarah K.’s storefront', s: 'New customer · Pro · Substack', amt: '$49.00', st: 'ok', ago: '2m' },
      { ava: 'devon', t: 'Devon A.’s storefront', s: 'New customer · Team · YouTube', amt: '$129.00', st: 'ok', ago: '18m' },
      { ava: 'lena', t: 'Lena O.’s storefront', s: 'Renewal · Pro · TikTok', amt: '$49.00', st: 'ok', ago: '41m' },
      { ava: 'mika', t: 'Mika R.’s storefront', s: 'New customer · Pro · Reddit', amt: '$49.00', st: 'ok', ago: '1h' },
    ]
  : [
      { mark: 'fernwood', t: 'Fernwood', s: 'New customer · Pro', amt: '+$9.80', st: 'ok', ago: '2m' },
      { mark: 'tallyhawk', t: 'Tallyhawk', s: 'New customer · Annual', amt: '+$28.80', st: 'ok', ago: '33m' },
      { mark: 'fernwood', t: 'Fernwood', s: 'Renewal · Pro', amt: '+$9.80', st: 'ok', ago: '1h' },
      { mark: 'quietly', t: 'Quietly', s: 'New customer · Lifetime', amt: '+$14.40', st: 'ok', ago: '3h' },
    ];
---

<figure class:list={['w3d', side]} data-window={side} role="img" aria-label={label} style={`${wide.replace(/--/g, '--w-')};${narrow.replace(/--/g, '--n-')}`}>
  <div class="stage">
    <span class="shade" aria-hidden="true"></span>
    <img class="shell wide" src="/assets/window/window-wide-1600.webp" srcset="/assets/window/window-wide-900.webp 900w, /assets/window/window-wide-1600.webp 1600w" sizes="(max-width: 960px) 1px, 70vw" alt="" decoding="async" fetchpriority="high" />
    <img class="shell narrow" src="/assets/window/window-narrow-900.webp" srcset="/assets/window/window-narrow-900.webp 900w, /assets/window/window-narrow-1600.webp 1600w" sizes="(max-width: 960px) 140vw, 1px" alt="" decoding="async" />
    <div class="win" aria-hidden="true">
      <div class="sheet">
        <div class="chrome">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url num">
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 5.5V4a2.5 2.5 0 0 1 5 0v1.5M2.5 5.5h7v5h-7Z" /></svg>
            <span data-win-url>{brand ? 'app.comarket.si/sales' : 'app.comarket.si/earnings'}</span>
          </span>
          <span class="ex num">Example</span>
        </div>

        <div class="appbar">
          <b class="wm">Comarket</b>
          <nav class="tabs">
            {(brand ? ['Sales', 'Creators', 'Offers', 'Storefront'] : ['Earnings', 'Offers', 'My page']).map((t, i) => <span class:list={{ on: i === 0 }}>{t}</span>)}
          </nav>
          <span class="acct">
            {
              brand ? (
                <span class="logo" data-win-logo>
                  <BrandMark id="fernwood" size="100%" />
                </span>
              ) : (
                <span class="ava face" data-win-face style="background-image:url(/assets/posts/avatars/sarah.jpg)" />
              )
            }
            <span class:list={['acct-name', { fern: brand }]} data-win-name>{brand ? 'Fernwood' : 'Sarah K.'}</span>
          </span>
        </div>

        <div class="body">
          <header class="top">
            <b>{brand ? 'Sales from creators' : 'Earnings'}</b>
            <span>October · this month</span>
          </header>
          <div class="kpis num">
            {
              brand ? (
                <>
                  <div class="kpi hot"><span>New customers</span><b data-win-k0>36</b></div>
                  <div class="kpi"><span>Revenue</span><b data-win-k1>$1,862</b></div>
                  <div class="kpi"><span>Cost per sale</span><b>$17.15</b></div>
                </>
              ) : (
                <>
                  <div class="kpi hot"><span>Earned</span><b data-win-k0>$372.40</b></div>
                  <div class="kpi"><span>Sales</span><b data-win-k1>31</b></div>
                  <div class="kpi"><span>Next payout</span><b>Nov 30</b></div>
                </>
              )
            }
          </div>
          <div class="feed">
            <p class="feed-h">{brand ? 'Latest sales' : 'Latest sales you sent'}</p>
            <ol class="rows" data-win-rows>
              {
                rows.map((r) => (
                  <li class="row">
                    {r.mark ? (
                      <span class="ava mk">
                        <BrandMark id={r.mark} size="62%" />
                      </span>
                    ) : (
                      <span class="ava" style={`background-image:url(/assets/posts/avatars/${r.ava}.jpg)`} />
                    )}
                    <span class="txt">
                      <b>{r.t}</b>
                      <span>{r.s}</span>
                    </span>
                    <span class="amt">
                      <b>{r.amt}</b>
                      <span class="ago">{r.ago}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  /* The box is the render, scaled: its width is the screen's width (--ww) over the screen's share of the render
     (--span), and it's pulled up and left so the screen's top left corner sits at the box's origin in the caller's
     layout. Inside, .stage is the render at its own pixel size, scaled by --k (the box's width over the render's,
     as a plain number), and the screen sheet is mapped onto the render's screen face. */
  .w3d {
    --iw: var(--w-iw);
    --ih: var(--w-ih);
    --sw: var(--w-sw);
    --sh: var(--w-sh);
    --span: var(--w-span);
    --ox: var(--w-ox);
    --oy: var(--w-oy);
    --m: var(--w-m);
    --box: calc(var(--ww, 560px) / var(--span));
    position: relative;
    container-type: inline-size;
    width: var(--box);
    aspect-ratio: calc(var(--iw) / 1px) / calc(var(--ih) / 1px);
    margin: calc(-1 * var(--oy) * var(--box)) 0 0 calc(-1 * var(--ox) * var(--box));
    font-family: var(--sans);
    text-align: left;
    pointer-events: none;
  }
  @media (max-width: 960px) {
    .w3d {
      --iw: var(--n-iw);
      --ih: var(--n-ih);
      --sw: var(--n-sw);
      --sh: var(--n-sh);
      --span: var(--n-span);
      --ox: var(--n-ox);
      --oy: var(--n-oy);
      --m: var(--n-m);
    }
  }
  .stage {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--iw);
    height: var(--ih);
    transform-origin: 0 0;
    transform: scale(tan(atan2(100cqw, var(--iw))));
  }
  .shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .shell.narrow {
    display: none;
  }
  @media (max-width: 960px) {
    .shell.wide {
      display: none;
    }
    .shell.narrow {
      display: block;
    }
  }
  .win,
  .shade {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--sw);
    height: var(--sh);
    transform-origin: 0 0;
    transform: var(--m);
  }
  .win {
    container: win / inline-size;
  }
  /* the window's shadow on the page, drawn in the screen's own plane so the perspective carries it: a tight contact
     shadow and a wide soft one, both the page's ink, falling down and a little left (the light is upper right) */
  .shade {
    border-radius: 16px;
    box-shadow:
      0 2px 4px rgb(30 14 63 / 0.1),
      -6px 14px 28px -6px rgb(30 14 63 / 0.18),
      -18px 46px 90px -18px rgb(30 14 63 / 0.3);
  }

  /* the screen: Comarket's app, drawn at the render's screen size (760 x 420, or 560 x 480 on phones) */
  .sheet {
    --p: #1e6b47;
    --p-on: #ffffff;
    --paper-w: #fbfaf7;
    --ink-w: #17141f;
    --muted-w: #6b6577;
    --line-w: #ece8e1;
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    background: var(--paper-w);
    color: var(--ink-w);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(30 14 63 / 0.1);
    transition: background-color 0.6s var(--ease);
  }
  /* the render's light carries across the glass, from the upper right */
  .sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 0) 52%, rgb(255 255 255 / 0.2) 70%, rgb(255 255 255 / 0) 84%);
  }
  .chrome {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding: 0 14px;
    background: #f1eee8;
    border-bottom: 1px solid var(--line-w);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d9d3ca;
  }
  .url {
    flex: 1;
    min-width: 0;
    height: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    border-radius: 7px;
    background: #fff;
    font-size: 11.5px;
    color: var(--muted-w);
    white-space: nowrap;
    overflow: hidden;
  }
  .url svg {
    flex: none;
    width: 10px;
    height: 10px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .ex {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-w);
  }
  .appbar {
    flex: none;
    display: flex;
    align-items: center;
    gap: 22px;
    height: 44px;
    padding: 0 20px;
    border-bottom: 1px solid var(--line-w);
    background: #fff;
  }
  .wm {
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .tabs {
    display: flex;
    gap: 18px;
    height: 100%;
    font-size: 12.5px;
    color: var(--muted-w);
  }
  .tabs span {
    display: flex;
    align-items: center;
    border-bottom: 2px solid transparent;
  }
  .tabs .on {
    color: var(--ink-w);
    font-weight: 600;
    border-bottom-color: var(--p);
  }
  .acct {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--line-w);
  }
  .logo {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    background: #fff center / 80% no-repeat;
  }
  .logo.has-logo :global(svg) {
    display: none;
  }
  .acct .ava {
    width: 24px;
    height: 24px;
  }
  .acct-name {
    font-size: 13px;
    font-weight: 600;
  }
  /* the brand's account carries its own type (design/brands/README.md) */
  .acct-name.fern {
    font-family: 'Fernwood Serif', Georgia, serif;
    font-weight: 400;
    font-size: 15px;
    color: #0f2a1e;
  }
  .body {
    flex: 1;
    min-height: 0;
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 18px 20px;
  }
  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .top b {
    font-size: 17px;
    letter-spacing: -0.02em;
  }
  .top span {
    font-size: 12px;
    color: var(--muted-w);
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .kpi {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line-w);
  }
  .kpi span {
    font-family: var(--sans);
    font-size: 11.5px;
    color: var(--muted-w);
  }
  .kpi b {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  /* the number that matters, in the brand's own colour */
  .kpi.hot {
    background: var(--p);
    border-color: var(--p);
  }
  .kpi.hot span,
  .kpi.hot b {
    color: var(--p-on);
  }
  .kpi.hot span {
    opacity: 0.82;
  }
  .feed {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .feed-h {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted-w);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    max-height: calc(4 * 44px + 3 * 6px);
    overflow: hidden;
  }
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 12px;
    border-radius: 11px;
    background: #fff;
    border: 1px solid var(--line-w);
  }
  .row.new {
    animation: row-in 0.55s var(--ease) both;
  }
  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
  .ava {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--line-w) center / cover;
  }
  .ava.mk {
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: #f4f1ec;
  }
  .ava.face.initial {
    display: grid;
    place-items: center;
    background: var(--p);
    color: var(--p-on);
    font-size: 12px;
    font-weight: 700;
  }
  .txt {
    display: grid;
    min-width: 0;
  }
  .txt b {
    font-size: 13px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .txt span {
    font-size: 11px;
    color: var(--muted-w);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .amt {
    display: grid;
    justify-items: end;
    gap: 2px;
  }
  .amt b {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 400;
    padding: 1px 6px;
    margin-right: -6px;
    border-radius: 4px;
  }
  .ago {
    font-size: 11px;
    color: var(--muted-w);
  }
  /* the sale landing: the one place yellow goes */
  .row.new .amt b {
    animation: sale 1.6s var(--ease) both;
  }
  @keyframes sale {
    0%,
    40% {
      background: var(--yellow);
    }
    100% {
      background: transparent;
    }
  }

  /* wide (the desktop render): totals down the left, sales on the right */
  @container win (min-width: 700px) {
    .body {
      grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
      grid-template-areas:
        'top top'
        'kpis feed';
      column-gap: 18px;
    }
    .top {
      grid-area: top;
    }
    .kpis {
      grid-area: kpis;
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding-top: 24px;
    }
    .kpi {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      height: 58px;
    }
    .feed {
      grid-area: feed;
    }
  }
  /* narrow (phones): only the open tab */
  @container win (max-width: 699px) {
    .tabs span:not(.on) {
      display: none;
    }
    /* three sales fit the phone's screen */
    .rows {
      max-height: calc(3 * 44px + 2 * 6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row.new,
    .row.new .amt b {
      animation: none;
    }
  }
</style>

<script>
  import { onPage, reduceMotion } from '../scripts/ui';
  import { paletteFrom } from '../lib/palette';

  onPage(() => {
    const fig = document.querySelector<HTMLElement>('[data-window]');
    if (!fig) return [];
    const brand = fig.dataset.window === 'brands';
    const sheet = fig.querySelector<HTMLElement>('.sheet')!;
    const list = fig.querySelector<HTMLElement>('[data-win-rows]')!;
    const k0 = fig.querySelector<HTMLElement>('[data-win-k0]')!;
    const k1 = fig.querySelector<HTMLElement>('[data-win-k1]')!;
    const cleanups: Array<() => void> = [];
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    /* more example sales while it's on screen */
    const NEXT = brand
      ? [
          { ava: 'mika', t: 'Mika R.’s storefront', s: 'New customer · Pro · Reddit', amt: 49 },
          { ava: 'devon', t: 'Devon A.’s storefront', s: 'New customer · Team · YouTube', amt: 129 },
          { ava: 'sarah', t: 'Sarah K.’s storefront', s: 'New customer · Pro · Substack', amt: 49 },
          { ava: 'lena', t: 'Lena O.’s storefront', s: 'New customer · Pro · TikTok', amt: 49 },
        ]
      : [
          { mark: 'Fernwood', t: 'Fernwood', s: 'New customer · Pro', amt: 9.8 },
          { mark: 'Pagewell', t: 'Pagewell', s: 'New customer · Starter', amt: 5.8 },
          { mark: 'Fernwood', t: 'Fernwood', s: 'New customer · Team', amt: 25.8 },
          { mark: 'Tallyhawk', t: 'Tallyhawk', s: 'New customer · Monthly', amt: 2.4 },
        ];
    // the marks already drawn in the first rows, to copy into new ones
    const markOf = (name: string) => [...list.querySelectorAll('.row')].find((r) => r.querySelector('.txt b')?.textContent === name)?.querySelector('.ava')?.innerHTML ?? '';
    const marks: Record<string, string> = {};
    if (!brand) ['Fernwood', 'Tallyhawk', 'Quietly'].forEach((n) => (marks[n] = markOf(n)));
    let n0 = brand ? 36 : 372.4;
    let n1 = brand ? 1862 : 31;
    let i = 0;
    const scope = [...list.attributes].find((a) => a.name.startsWith('data-astro-cid'))?.name;
    const add = () => {
      const r = NEXT[i++ % NEXT.length] as { ava?: string; mark?: string; t: string; s: string; amt: number };
      const li = document.createElement('li');
      li.className = 'row new';
      const ava = r.ava
        ? `<span class="ava" style="background-image:url(/assets/posts/avatars/${r.ava}.jpg)"></span>`
        : `<span class="ava mk">${marks[r.mark!] || esc(r.t.charAt(0))}</span>`;
      const amt = brand ? `$${r.amt.toFixed(2)}` : `+$${r.amt.toFixed(2)}`;
      const tag = '<span class="ago">now</span>';
      li.innerHTML = `${ava}<span class="txt"><b>${esc(r.t)}</b><span>${esc(r.s)}</span></span><span class="amt"><b>${amt}</b>${tag}</span>`;
      if (scope) [li, ...li.querySelectorAll('*')].forEach((e) => e.setAttribute(scope, ''));
      list.prepend(li);
      while (list.children.length > 5) list.lastElementChild?.remove();
      if (brand) {
        n0 += 1;
        n1 += r.amt;
        k0.textContent = String(n0);
        k1.textContent = `$${Math.round(n1).toLocaleString('en-US')}`;
      } else {
        n0 += r.amt;
        n1 += 1;
        k0.textContent = `$${n0.toFixed(2)}`;
        k1.textContent = String(n1);
      }
      list.querySelectorAll('.row:not(:first-child) .ago').forEach((e) => {
        if (e.textContent === 'now') e.textContent = '1m';
      });
    };
    let seen = false;
    const io = new IntersectionObserver(([e]) => (seen = e.isIntersecting), { threshold: 0.4 });
    io.observe(fig);
    const timer = setInterval(() => {
      if (seen && !reduceMotion() && !document.hidden) add();
    }, 3400);
    cleanups.push(() => {
      io.disconnect();
      clearInterval(timer);
    });

    /* the claim field: a visitor's own brand (its name, logo and the logo's palette) or handle */
    const name = fig.querySelector<HTMLElement>('[data-win-name]')!;
    const onBrand = (e: Event) => {
      const d = (e as CustomEvent<{ name: string; color: string | null; icon: string | null }>).detail;
      name.textContent = d.name;
      name.classList.remove('fern');
      if (d.color) sheet.style.setProperty('--p', d.color);
      const logo = fig.querySelector<HTMLElement>('[data-win-logo]');
      if (logo && d.icon) {
        const img = new Image();
        img.onload = () => {
          logo.style.backgroundImage = `url("${d.icon}")`;
          logo.classList.add('has-logo');
          const pal = paletteFrom(img, d.color);
          if (!pal) return;
          sheet.style.setProperty('--p', pal.primary);
          sheet.style.setProperty('--p-on', pal.onPrimary);
          sheet.style.setProperty('--paper-w', pal.paper);
          dispatchEvent(new CustomEvent('brand:palette', { detail: pal }));
        };
        img.src = d.icon;
      }
    };
    const onCreator = (e: Event) => {
      const h = String((e as CustomEvent<string>).detail).replace(/^@/, '');
      name.textContent = `@${h}`;
      const face = fig.querySelector<HTMLElement>('[data-win-face]');
      if (face) {
        face.style.backgroundImage = 'none';
        face.textContent = h.charAt(0).toUpperCase();
        face.classList.add('initial');
      }
    };
    addEventListener('stage:brand', onBrand);
    addEventListener('stage:creator', onCreator);
    cleanups.push(() => {
      removeEventListener('stage:brand', onBrand);
      removeEventListener('stage:creator', onCreator);
    });
    return cleanups;
  });
</script>
