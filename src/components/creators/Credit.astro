---
/* A coupon extension tries to swap the referral at checkout. It can't, because credit isn't in the browser.
   The checkout is Fernwood's own, as the stage phone shows it (design/brands/README.md). */
import BrandMark from '../examples/BrandMark.astro';
---

<section class="section band-ink on-ink credit" id="credit" aria-labelledby="credit-h">
  <div class="wrap grid">
    <div class="step-head">
      <h2 class="display-l" id="credit-h" data-reveal>Your sales stay yours.</h2>
      <p class="lede muted" data-reveal style="--d:.1s">Coupon add-ons in the browser can swap in their own link at checkout and take the credit. We record who sent the buyer on our side, so they can’t.</p>
    </div>

    <div class="scene" data-credit aria-hidden="true">
      <div class="checkout">
        <div class="top"><BrandMark id="fernwood" size="20" /><span>Fernwood</span></div>
        <p class="c-hl">Start your <em>free</em> trial</p>
        <div class="fields">
          <span class="f"><span class="fl">Work email</span><span class="fv">jordan@acme.io</span></span>
          <span class="f"><span class="fl">Card</span><span class="fv num">4242 4242 4242 4242</span></span>
        </div>
        <div class="order">
          <div class="row"><span class="nm">Fernwood</span><span>$49/mo</span></div>
          <span class="perk">30 days free with Sarah’s link</span>
          <div class="row due"><b>Due today</b><b>$0.00</b></div>
          <div class="row then"><span>First payment, Nov 22</span><span>$49.00</span></div>
        </div>
        <div class="ref">
          <span class="face"></span>
          <span class="who"><b>Credited to Sarah K.</b><span class="label">recorded on comarket.si</span></span>
        </div>
        <span class="pay">Start my free trial</span>
      </div>
      <div class="ext">
        <div class="ext-h"><span class="ext-logo">%</span><b>Coupon add-on</b></div>
        <span class="ext-msg" data-msg>Trying 12 codes…</span>
        <span class="bar"><i></i></span>
      </div>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .step-head {
    margin-bottom: 0;
  }
  .scene {
    position: relative;
    min-height: 420px;
    display: grid;
    place-items: center;
  }
  .checkout {
    width: min(420px, 100%);
    background: var(--white);
    color: #16201b;
    border-radius: 22px;
    padding: 24px;
    display: grid;
    gap: 18px;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6);
  }
  .checkout {
    background: #f3f0e8;
    color: #0f2a1e;
    font-family: 'Fernwood Sans', system-ui, sans-serif;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 23px/1 'Fernwood Serif', Georgia, serif;
  }
  /* Fernwood's own checkout (design/brands/README.md): serif head with one italic word in Fern, white fields on Paper */
  .c-hl {
    font: 34px/1.04 'Fernwood Serif', Georgia, serif;
    letter-spacing: -0.015em;
    padding-bottom: 2px;
  }
  .c-hl em {
    color: #1e6b47;
  }
  .fields {
    display: grid;
    gap: 8px;
  }
  .f {
    display: grid;
    gap: 4px;
  }
  .fl {
    font-size: 12px;
    color: #6e7d72;
  }
  .fv {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    background: #fff;
    border: 1px solid #dce2d5;
    font-size: 14px;
  }
  .fv.num {
    font-family: 'Fernwood Sans', system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .order {
    display: grid;
    gap: 6px;
    padding: 16px;
    border-radius: 14px;
    background: #fff;
    font-size: 14px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .nm {
    font: 19px/1 'Fernwood Serif', Georgia, serif;
  }
  .perk {
    font-size: 13px;
    font-weight: 600;
    color: #1e6b47;
  }
  .due {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid #dce2d5;
    font-weight: 600;
  }
  .then {
    font-size: 13px;
    color: #6e7d72;
  }
  .face {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: url(/assets/posts/avatars/sarah.jpg) center / cover;
  }
  .ref {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 14px;
    border-radius: 14px;
    border: 1.5px solid var(--benzol);
    background: color-mix(in oklab, var(--benzol) 7%, white);
  }
  .who {
    display: grid;
    gap: 2px;
  }
  .who .label {
    color: #5b6660;
  }
  .pay {
    height: 48px;
    border-radius: 999px;
    background: #1e6b47;
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 600;
  }
  .ext {
    position: absolute;
    top: -12px;
    right: max(0px, calc(50% - 270px));
    width: 230px;
    padding: 14px;
    border-radius: 14px;
    background: #fff;
    color: #222;
    display: grid;
    gap: 8px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7);
    transform: translateY(-14px) rotate(2deg);
    opacity: 0;
  }
  .ext-h {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
  }
  .ext-logo {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: #3b3b3b;
    color: #fff;
    font: 700 12px/1 system-ui, sans-serif;
  }
  .ext-msg {
    font-size: 13px;
    color: #555;
  }
  .bar {
    height: 4px;
    border-radius: 2px;
    background: #eee;
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 0;
    background: #888;
  }
  .scene.play .ext {
    animation: ext 5.6s var(--ease) infinite;
  }
  .scene.play .bar i {
    animation: bar 5.6s linear infinite;
  }
  .scene.play .ref {
    animation: hold 5.6s var(--ease) infinite;
  }
  @keyframes ext {
    0%,
    6% {
      opacity: 0;
      transform: translateY(-14px) rotate(2deg);
    }
    14%,
    72% {
      opacity: 1;
      transform: translateY(0) rotate(2deg);
    }
    84%,
    100% {
      opacity: 0;
      transform: translateY(-10px) rotate(2deg);
    }
  }
  @keyframes bar {
    0%,
    14% {
      width: 0;
    }
    52%,
    100% {
      width: 100%;
    }
  }
  @keyframes hold {
    0%,
    52% {
      box-shadow: 0 0 0 0 rgb(0 110 184 / 0);
    }
    58% {
      box-shadow: 0 0 0 8px rgb(0 110 184 / 0.25);
    }
    70%,
    100% {
      box-shadow: 0 0 0 0 rgb(0 110 184 / 0);
    }
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    /* on one column the add-on sits above the card's corner, clear of the headline */
    .scene {
      padding-top: 56px;
    }
    .ext {
      top: 0;
      right: 0;
      width: 210px;
    }
  }
</style>

<script>
  import { onPage, onceVisible, reduceMotion } from '../../scripts/ui';
  onPage(() => {
    const scene = document.querySelector<HTMLElement>('[data-credit]');
    if (!scene) return [];
    const msg = scene.querySelector<HTMLElement>('[data-msg]')!;
    let timers: number[] = [];
    const cycle = () => {
      msg.textContent = 'Trying 12 codes…';
      timers.push(window.setTimeout(() => (msg.textContent = 'Swapping the referral…'), 1700));
      timers.push(window.setTimeout(() => (msg.textContent = 'Nothing to swap.'), 2950));
    };
    let loop = 0;
    const stop = onceVisible(scene, () => {
      if (reduceMotion()) return;
      scene.classList.add('play');
      cycle();
      loop = window.setInterval(cycle, 5600);
    });
    return [
      stop,
      () => {
        clearInterval(loop);
        timers.forEach(clearTimeout);
        timers = [];
      },
    ];
  });
</script>
