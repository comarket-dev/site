---
/* Example posts with a storefront link, on the platforms creators already use. Fictional creators, tagged. */
import Showcase from '../examples/Showcase.astro';

---

<section class="section posts" id="examples" aria-labelledby="posts-h">
  <div class="wrap head">
    <h2 class="display-l" id="posts-h" data-reveal>Post the way you already do. The link does the selling.</h2>
    <p class="lede muted" data-reveal style="--d:.08s">
      A newsletter, a video, a TikTok or a Reddit post. Every link opens a storefront with your name on it.
    </p>
  </div>

  <Showcase side="creator" />
</section>

<style>
  .posts {
    padding-top: clamp(56px, 8vw, 120px);
    overflow-x: clip;
  }
  .head {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .head h2 {
    max-width: 16ch;
  }
</style>
