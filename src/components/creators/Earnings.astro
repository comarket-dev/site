---
/* Two scenes that share inputs: what one product could pay you, and where your rate peaks. */
---

<div data-earn>
  <section class="section est" id="earnings" aria-labelledby="est-h">
    <div class="wrap">
      <div class="step-head">
        <h2 class="display-l" id="est-h" data-reveal>See what your link could earn.</h2>
      </div>
      <div class="grid">
        <div class="controls">
          <label class="ctl">
            <span class="row"><span class="label">Views per post</span><b class="num" data-out="views">2,500</b></span>
            <input type="range" min="0" max="100" step="1" value="27" data-in="views" aria-label="Typical views per post" />
          </label>
          <label class="ctl">
            <span class="row"><span class="label">Posts a month that mention it</span><b class="num" data-out="posts">2</b></span>
            <input type="range" min="1" max="16" step="1" value="2" data-in="posts" aria-label="Posts per month" />
          </label>
          <label class="ctl">
            <span class="row"><span class="label">Product price</span><b class="num" data-out="price">$49/mo</b></span>
            <input type="range" min="9" max="199" step="1" value="49" data-in="price" aria-label="Product price per month" />
          </label>
          <label class="ctl">
            <span class="row"><span class="label">Your rate</span><b class="num" data-out="rate">20%</b></span>
            <input type="range" min="10" max="30" step="1" value="20" data-in="rate" aria-label="Your commission rate" />
          </label>
        </div>
        <div class="result">
          <span class="label">By month 12, per month</span>
          <b class="big" data-out="range">$90 to $520</b>
          <svg class="chart" viewBox="0 0 600 300" data-chart role="img" aria-label="Estimated monthly earnings over twelve months">
            <g data-grid></g>
            <path data-band fill="rgb(0 110 184 / 0.14)"></path>
            <path data-mid fill="none" stroke="#1E0E3F" stroke-width="2" vector-effect="non-scaling-stroke"></path>
            <g data-ticks></g>
          </svg>
          <p class="assume">An estimate from typical click and purchase rates, not a promise.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-2 rate" id="rate" aria-labelledby="rate-h">
    <div class="wrap">
      <div class="step-head">
        <h2 class="display-l" id="rate-h" data-reveal>Ask for more, match with fewer brands.</h2>
      </div>
      <div class="grid">
        <div class="controls">
          <label class="ctl">
            <span class="row"><span class="label">The rate you ask for</span><b class="num" data-out="ask">20%</b></span>
            <input type="range" min="5" max="40" step="1" value="20" data-in="ask" aria-label="Commission rate you ask for" />
          </label>
          <dl class="reads num">
            <div><dt>Brands that accept</dt><dd data-out="match">24 of 40</dd></div>
            <div><dt>Expected per month</dt><dd data-out="pay">$310</dd></div>
            <div><dt>Your sweet spot</dt><dd data-out="best">22%</dd></div>
          </dl>
          <p class="assume">Brands set a maximum rate. You set your ask. You match where they meet.</p>
        </div>
        <svg class="chart" viewBox="0 0 600 300" data-rate-chart role="img" aria-label="Expected payout by asking rate">
          <g data-rgrid></g>
          <path data-rarea fill="rgb(30 14 63 / 0.06)"></path>
          <path data-rline fill="none" stroke="#1E0E3F" stroke-width="2" vector-effect="non-scaling-stroke"></path>
          <line data-rbest stroke="#006EB8" stroke-width="1" stroke-dasharray="4 4" y1="0" y2="270"></line>
          <circle data-rdot r="7" fill="#FFF200" stroke="#1E0E3F" stroke-width="2"></circle>
          <g data-rticks></g>
        </svg>
      </div>
    </div>
  </section>
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .controls {
    display: grid;
    gap: 26px;
  }
  .ctl {
    display: grid;
    gap: 10px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .row b {
    font-size: 20px;
    font-weight: 400;
  }
  .result {
    display: grid;
    gap: 14px;
  }
  .big {
    font-size: clamp(48px, 7vw, 112px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .chart {
    width: 100%;
    height: clamp(220px, 26vw, 340px);
    overflow: visible;
  }
  .chart :global(text) {
    font: 11px var(--mono);
    fill: var(--graphite);
  }
  .assume {
    max-width: 62ch;
    font-size: 13.5px;
    color: var(--graphite);
  }
  .reads {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--ink);
  }
  .reads div {
    display: flex;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
  }
  .reads dt {
    font-family: var(--sans);
    color: var(--graphite);
  }
  .reads dd {
    margin: 0;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { brandsMatching, estimate, EXAMPLE_CEILINGS, payoutAtAsk } from '../../lib/estimate';
  import { fillRange, onPage, track } from '../../scripts/ui';

  const SVGNS = 'http://www.w3.org/2000/svg';
  let W = 600;
  let H = 270;
  /** Draw in real pixels so labels stay readable at any width. */
  function fit(svg: SVGSVGElement) {
    W = Math.max(240, Math.round(svg.clientWidth || 600));
    H = Math.max(160, Math.round((svg.clientHeight || 300) - 34));
    svg.setAttribute('viewBox', `0 -14 ${W} ${H + 48}`);
  }

  function niceMax(v: number) {
    if (v <= 0) return 10;
    const p = Math.pow(10, Math.floor(Math.log10(v)));
    const n = v / p;
    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * p;
  }
  const money = (n: number) => (n >= 1000 ? `$${(Math.round(n / 100) / 10).toLocaleString('en-US')}k` : `$${Math.round(n / 10) * 10}`);
  function text(parent: Element, x: number, y: number, s: string, anchor = 'middle') {
    const t = document.createElementNS(SVGNS, 'text');
    t.setAttribute('x', String(x));
    t.setAttribute('y', String(y));
    t.setAttribute('text-anchor', anchor);
    t.textContent = s;
    parent.append(t);
  }
  function hline(parent: Element, y: number, stroke: string) {
    const l = document.createElementNS(SVGNS, 'line');
    l.setAttribute('x1', '0');
    l.setAttribute('x2', String(W));
    l.setAttribute('y1', String(y));
    l.setAttribute('y2', String(y));
    l.setAttribute('stroke', stroke);
    l.setAttribute('vector-effect', 'non-scaling-stroke');
    parent.append(l);
  }

  onPage(() => {
    const root = document.querySelector<HTMLElement>('[data-earn]');
    if (!root) return [];
    const $in = (k: string) => root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const $out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    let used = false;

    const views = () => Math.round(500 * Math.pow(400, Number($in('views').value) / 100) / 100) * 100;

    const draw = () => {
      ['views', 'posts', 'price', 'rate', 'ask'].forEach((k) => fillRange($in(k)));
      const input = { viewsPerPost: views(), postsPerMonth: Number($in('posts').value), price: Number($in('price').value), rate: Number($in('rate').value) };
      $out('views').textContent = input.viewsPerPost.toLocaleString('en-US');
      $out('posts').textContent = String(input.postsPerMonth);
      $out('price').textContent = `$${input.price}/mo`;
      $out('rate').textContent = `${input.rate}%`;
      const e = estimate(input);
      const lo = e.low[11];
      const hi = e.high[11];
      $out('range').textContent = `${money(lo)} to ${money(hi)}`;

      // earnings chart
      fit(q<SVGSVGElement>('[data-chart]'));
      const max = niceMax(Math.max(...e.high) * 1.05);
      const x = (m: number) => (m / 11) * W;
      const y = (v: number) => H - (v / max) * H;
      const top = e.high.map((v, m) => `${m ? 'L' : 'M'}${x(m)},${y(v)}`).join('');
      const bot = [...e.low].reverse().map((v, k) => `L${x(11 - k)},${y(v)}`).join('');
      q('[data-band]').setAttribute('d', `${top}${bot}Z`);
      q('[data-mid]').setAttribute('d', e.mid.map((v, m) => `${m ? 'L' : 'M'}${x(m)},${y(v)}`).join(''));
      const grid = q('[data-grid]');
      const ticks = q('[data-ticks]');
      grid.replaceChildren();
      ticks.replaceChildren();
      [0, 0.5, 1].forEach((f) => {
        hline(grid, y(max * f), '#EADCC6');
        text(ticks, 0, y(max * f) - 6, f ? money(max * f) : '$0', 'start');
      });
      [1, 6, 12].forEach((m) => text(ticks, x(m - 1), H + 22, `month ${m}`, m === 1 ? 'start' : m === 12 ? 'end' : 'middle'));

      // rate chart: payout per brand at 1% from the mid estimate at month 12
      fit(q<SVGSVGElement>('[data-rate-chart]'));
      const perBrand = e.mid[11] / Math.max(1, input.rate);
      const ask = Number($in('ask').value);
      $out('ask').textContent = `${ask}%`;
      const xs = Array.from({ length: 36 }, (_, k) => 5 + k);
      const ys = xs.map((a) => payoutAtAsk(a, perBrand));
      const rmax = niceMax(Math.max(...ys) * 1.1);
      const rx = (a: number) => ((a - 5) / 35) * W;
      const ry = (v: number) => H - (v / rmax) * H;
      const line = ys.map((v, k) => `${k ? 'L' : 'M'}${rx(xs[k])},${ry(v)}`).join('');
      q('[data-rline]').setAttribute('d', line);
      q('[data-rarea]').setAttribute('d', `${line}L${W},${H}L0,${H}Z`);
      const bestK = ys.indexOf(Math.max(...ys));
      const best = xs[bestK];
      const bl = q<SVGLineElement>('[data-rbest]');
      bl.setAttribute('x1', String(rx(best)));
      bl.setAttribute('x2', String(rx(best)));
      bl.setAttribute('y2', String(H));
      const dot = q<SVGCircleElement>('[data-rdot]');
      dot.setAttribute('cx', String(rx(ask)));
      dot.setAttribute('cy', String(ry(payoutAtAsk(ask, perBrand))));
      const rgrid = q('[data-rgrid]');
      const rticks = q('[data-rticks]');
      rgrid.replaceChildren();
      rticks.replaceChildren();
      [0, 0.5, 1].forEach((f) => {
        hline(rgrid, ry(rmax * f), '#EADCC6');
        text(rticks, 0, ry(rmax * f) - 6, f ? money(rmax * f) : '$0', 'start');
      });
      [5, 15, 25, 40].forEach((a) => text(rticks, rx(a), H + 22, `${a}%`, a === 5 ? 'start' : a === 40 ? 'end' : 'middle'));
      text(rticks, rx(best), -10, 'sweet spot');
      $out('match').textContent = `${brandsMatching(ask)} of ${EXAMPLE_CEILINGS.length}`;
      $out('pay').textContent = money(payoutAtAsk(ask, perBrand));
      $out('best').textContent = `${best}%`;
    };

    const onInput = (e: Event) => {
      draw();
      if (!used) {
        used = true;
        track((e.target as HTMLElement).dataset.in === 'ask' ? 'rate_used' : 'estimator_used');
      }
    };
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-in]'));
    inputs.forEach((i) => i.addEventListener('input', onInput));
    draw();
    const ro = new ResizeObserver(() => draw());
    root.querySelectorAll('svg').forEach((svg) => ro.observe(svg));
    return [() => inputs.forEach((i) => i.removeEventListener('input', onInput)), () => ro.disconnect()];
  });
</script>
