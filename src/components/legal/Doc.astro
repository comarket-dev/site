---
/* The frame every legal page shares: wordmark, title, date, contents and the list of legal pages. Placeholders written
   as [[LIKE THIS]] are highlighted, so nothing unfinished can pass for final text (list: design/legal/README.md).
   Section headings (h2) get ids and a contents list. Straight quotes in the text become curly ones, as in the UI. */
interface Props {
  title: string;
  lede?: string;
  updated: string;
  /** While true the page carries a visible draft note (and the page passes noindex to Base). */
  draft?: boolean;
  /** This page's path, to mark it in the list of legal pages. */
  current: string;
  toc?: boolean;
}
const { title, lede, updated, draft = true, current, toc = true } = Astro.props;

const DOCS = [
  { href: '/terms', label: 'Terms of use' },
  { href: '/privacy', label: 'Privacy policy' },
  { href: '/cookies', label: 'Cookie policy' },
  { href: '/brand-terms', label: 'Brand agreement' },
  { href: '/creator-terms', label: 'Creator agreement' },
  { href: '/dpa', label: 'Data processing addendum' },
];

const strip = (s: string) =>
  s
    .replace(/<[^>]+>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&[a-z#0-9]+;/gi, ' ')
    .trim();

/* Curly quotes in text only, never inside tags. */
const curl = (t: string) =>
  t
    .replace(/(\w)'/g, '$1’')
    .replace(/'(\w)/g, '‘$1')
    .replace(/(^|[\s(\[])"/g, '$1“')
    .replace(/"/g, '”');

const contents: { id: string; n?: string; text: string }[] = [];
const used = new Set<string>();
let html = await Astro.slots.render('default');
html = html.replace(/<h2(\s[^>]*)?>([\s\S]*?)<\/h2>/g, (_m, attrs = '', inner: string) => {
  const text = strip(inner);
  const own = /\sid="([^"]+)"/.exec(attrs)?.[1];
  let id =
    own ??
    text
      .toLowerCase()
      .replace(/^\d+\.\s*/, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
  if (!own) {
    let n = 2;
    const base = id;
    while (used.has(id)) id = `${base}-${n++}`;
  }
  used.add(id);
  // a numbered heading ("7. Fees") keeps its own number in the contents list, so the list doesn't number it twice
  const num = /^(\d+\.)\s*(.*)$/.exec(text);
  contents.push(num ? { id, n: num[1], text: curl(num[2]) } : { id, text: curl(text) });
  return `<h2${own ? attrs : `${attrs} id="${id}"`}>${inner}</h2>`;
});
/* On phones each table row becomes a card, so every cell needs its column's name to show beside it. */
html = html.replace(/<table(\s[^>]*)?>([\s\S]*?)<\/table>/g, (whole, _a, inner: string) => {
  const head = /<thead[^>]*>([\s\S]*?)<\/thead>/.exec(inner)?.[1];
  if (!head) return whole;
  const names = [...head.matchAll(/<th[^>]*>([\s\S]*?)<\/th>/g)].map((m) => strip(m[1]).replace(/"/g, ''));
  const body = inner.replace(/<tr(\s[^>]*)?>([\s\S]*?)<\/tr>/g, (row, ra = '', cells: string) => {
    if (/<th[\s>]/.test(cells)) return row;
    let i = 0;
    return `<tr${ra}>${cells.replace(/<td(\s[^>]*)?>/g, (_m, ca = '') => `<td${ca} data-label="${names[i++] ?? ''}">`)}</tr>`;
  });
  return whole.replace(inner, body);
});
const numbered = contents.some((c) => c.n);
// text nodes only: a placeholder inside an attribute (a mailto link) stays as it is
html = html.replace(/>([^<]+)</g, (_m, t: string) => `>${curl(t).replace(/\[\[([^\]]+)\]\]/g, '<span class="ph">[[$1]]</span>')}<`);
---

<header class="legal-top wrap">
  <a class="wm" href="/?fork=1">Comarket</a>
</header>
<main class="wrap legal-doc">
  <span class="label">Last updated {updated}</span>
  <h1 class="display-l">{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  {
    draft && (
      <p class="draft" role="note">
        Draft for legal review. Text in double square brackets is still to be filled in, and nothing here is in force
        yet.
      </p>
    )
  }
  {
    toc && contents.length > 3 && (
      <nav class="toc" aria-label="On this page">
        <span class="label">On this page</span>
        <ol class:list={{ numbered }}>
          {contents.map((c) => (
            <li>
              <a href={`#${c.id}`}>
                {numbered && <span class="n">{c.n}</span>}
                {c.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <div class="body" set:html={html} />
  <nav class="others" aria-label="Legal pages">
    <span class="label">Legal</span>
    <ul>
      {
        DOCS.map((d) => (
          <li>
            <a href={d.href} aria-current={d.href === current ? 'page' : undefined}>
              {d.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</main>

<style is:global>
  .legal-top {
    padding-block: calc(22px + env(safe-area-inset-top, 0px)) 0;
    position: relative;
    z-index: 2;
  }
  .legal-top .wm {
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .legal-doc {
    position: relative;
    z-index: 2;
    max-width: 880px;
    padding-block: clamp(64px, 10vw, 140px);
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .legal-doc h1 {
    margin-top: 6px;
  }
  .legal-doc .draft {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    border: 1px dashed var(--ink);
    border-radius: 12px;
    padding: 12px 14px;
    max-width: 62ch;
  }
  .legal-doc .toc {
    display: grid;
    gap: 10px;
    padding-block: 8px;
    border-block: 1px solid var(--rule);
  }
  .legal-doc .toc ol {
    margin: 0;
    padding-left: 2.1em;
    columns: 2 260px;
    column-gap: 32px;
    font-size: 15px;
    line-height: 1.5;
  }
  .legal-doc .toc li {
    break-inside: avoid;
    padding-block: 2px;
  }
  .legal-doc .toc ol.numbered {
    list-style: none;
    padding-left: 0;
  }
  .legal-doc .toc .n {
    display: inline-block;
    min-width: 2.3ch;
    margin-right: 0.5ch;
    font-variant-numeric: tabular-nums;
  }
  .legal-doc .toc a {
    text-decoration: none;
  }
  .legal-doc .toc a:hover {
    text-decoration: underline;
  }
  .legal-doc .body {
    display: grid;
    gap: 16px;
    min-width: 0;
    font-size: 17px;
    line-height: 1.55;
  }
  .legal-doc .body h2 {
    margin-top: 28px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    scroll-margin-top: 24px;
  }
  .legal-doc .body h3 {
    margin-top: 10px;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .legal-doc .body p,
  .legal-doc .body ul,
  .legal-doc .body ol {
    max-width: 66ch;
  }
  .legal-doc .body ul,
  .legal-doc .body ol {
    margin: 0;
    padding-left: 22px;
    display: grid;
    gap: 8px;
  }
  .legal-doc .body .n {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 400;
    color: var(--graphite);
    margin-right: 6px;
  }
  .legal-doc .body .short {
    background: var(--white);
    border: 1px solid var(--ink);
    border-radius: 18px;
    padding: 18px 20px;
    max-width: 66ch;
    display: grid;
    gap: 10px;
  }
  .legal-doc .body .short ul {
    max-width: none;
  }
  /* Tables scroll sideways inside their box on narrow screens; nothing is clipped. */
  .legal-doc .tbl {
    overflow-x: auto;
    max-width: 100%;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--white);
  }
  .legal-doc table {
    border-collapse: collapse;
    width: 100%;
    min-width: 640px;
    font-size: 14.5px;
    line-height: 1.45;
  }
  .legal-doc th,
  .legal-doc td {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--rule);
  }
  .legal-doc tr:last-child td {
    border-bottom: 0;
  }
  .legal-doc th {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--graphite);
  }
  /* Phones: rows stack as cards, each cell under its column name, so nothing is cut off at the edge. */
  @media (max-width: 680px) {
    .legal-doc .tbl {
      overflow: visible;
      border: 0;
      background: none;
    }
    .legal-doc table,
    .legal-doc tbody,
    .legal-doc tr,
    .legal-doc th,
    .legal-doc td {
      display: block;
      min-width: 0;
      width: auto;
    }
    .legal-doc thead {
      display: none;
    }
    .legal-doc tr {
      background: var(--white);
      border: 1px solid var(--rule);
      border-radius: 14px;
      padding: 6px 0;
    }
    .legal-doc tr + tr {
      margin-top: 10px;
    }
    .legal-doc td,
    .legal-doc th {
      border-bottom: 0;
      padding: 6px 14px;
    }
    .legal-doc td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--graphite);
      margin-bottom: 2px;
    }
    .legal-doc td[data-label]:first-child {
      font-weight: 700;
    }
    .legal-doc td:empty {
      display: none;
    }
  }
  .legal-doc code {
    font-family: var(--mono);
    font-size: 0.86em;
  }
  .legal-doc .ph {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--paper-2);
    border: 1px dashed var(--graphite);
    border-radius: 4px;
    padding: 0 4px;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .legal-doc .others {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 10px;
  }
  .legal-doc .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 15px;
  }
  .legal-doc .others a {
    text-decoration: none;
  }
  .legal-doc .others a:hover,
  .legal-doc .others a[aria-current='page'] {
    text-decoration: underline;
  }
</style>
