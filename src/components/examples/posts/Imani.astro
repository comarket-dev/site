---
/* Instagram post by the example creator imani, composed in design/posts (see scripts/render-posts.py for its media).
   Drawn at 360x752 design pixels; Post.astro scales it to fit. Fictional, labeled as an example where it's shown. */
---

<div class="root" aria-hidden="true">
<div class="sb light"><span>8:31</span><span class="r"><span class="bars"><i></i><i></i><i></i><i class="off"></i></span><svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0zM1 4.4a9.9 9.9 0 0 1 14 0l-1.4 1.4a7.9 7.9 0 0 0-11.2 0z"/></svg><span class="batt"><b style="width:86%"></b></span></span></div>
  <div class="top"><svg class="back" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg><div><small>IMANIMAKES</small><b>Posts</b></div></div>
  <div class="head">
    <span class="ring"><i></i></span>
    <span><b>imanimakes</b><small>Paid partnership with <strong>kindredskin</strong></small></span>
    <span class="sp"></span><span style="font-size:18px;letter-spacing:1px">···</span>
