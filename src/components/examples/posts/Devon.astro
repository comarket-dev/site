---
/* YouTube post by the example creator devon, composed in design/posts (see scripts/render-posts.py for its media).
   Drawn at 400x452 design pixels; Post.astro scales it to fit. Fictional, labeled as an example where it's shown. */
---

<div class="root" aria-hidden="true">
<div class="player"><span class="bar"><i></i></span></div>
  <div class="wrap">
    <h1>I tested 6 scheduling tools so you don't have to</h1>
    <div class="ch">
      <span class="av"></span>
      <span><b>Devon Builds</b><small>12.1K subscribers</small></span>
      <span class="sp"></span>
      <span class="like"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M7 10v10H4V10zM7 10l4-7c1.5 0 2.5 1 2.2 2.6L12.6 9H19a2 2 0 0 1 2 2.3l-1.2 7A2 2 0 0 1 17.8 20H7"/></svg>2.1K</span>
      <span class="sub">Subscribe</span>
    </div>
    <div class="desc">
      <b>48K views · 3 days ago</b><br>
      Try Orbitly free for 45 days 👉 <a>orbitly.comarket.si/creators/devon</a><br>
      0:00 the email tag problem<br>
      1:52 all 6 tools, ranked <span class="more">...more</span>
    </div>
  </div>
</div>

<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
.root {
  position: relative;
  width: 400px;
  height: 452px;
 font-family: -apple-system, 'SF Pro Text', system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; }
svg { display: block; }

/* iOS status bar, light or dark */
.sb { position: absolute; left: 0; right: 0; top: 0; height: 46px; display: flex; align-items: center; justify-content: space-between; padding: 6px 26px 0 34px; font: 600 15px/1 -apple-system, system-ui; z-index: 50; }
.sb.dark { color: #fff; }
.sb.light { color: #000; }
.sb .r { display: flex; align-items: center; gap: 5px; }
.sb .bars { display: flex; align-items: flex-end; gap: 1.5px; height: 11px; }
.sb .bars i { width: 3px; border-radius: 1px; background: currentColor; }
.sb .bars i:nth-child(1) { height: 4px; } .sb .bars i:nth-child(2) { height: 6px; } .sb .bars i:nth-child(3) { height: 8.5px; } .sb .bars i:nth-child(4) { height: 11px; }
.sb .bars i.off { opacity: 0.35; }
.sb .batt { position: relative; width: 25px; height: 12px; border-radius: 4px; border: 1px solid currentColor; opacity: 0.9; padding: 1.5px; }
.sb .batt::after { content: ''; position: absolute; right: -3.5px; top: 3.5px; width: 2px; height: 4px; border-radius: 0 1px 1px 0; background: currentColor; opacity: 0.5; }
.sb .batt b { display: block; height: 100%; border-radius: 2px; background: currentColor; }
.sb .batt.low b { background: #ffd60a; }


  /* The watch page on desktop, below the player: title, channel, and the description box with the link above "more" */
  .root { width: 400px; height: 452px; background: #fff; color: #0f0f0f; font-family: Roboto, -apple-system, system-ui, sans-serif; }
  .player { position: relative; width: 400px; height: 225px; background: #000 url(/assets/posts/devon.jpg) center / cover; }
  .player .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(255,255,255,.35); }
  .player .bar i { display: block; width: 0; height: 100%; background: #f00; }
  .player .play { position: absolute; left: 50%; top: 50%; width: 56px; height: 40px; margin: -20px 0 0 -28px; border-radius: 12px; background: rgba(15,15,15,.78); }
  .player .play::after { content: ''; position: absolute; left: 23px; top: 12px; border-left: 14px solid #fff; border-top: 8px solid transparent; border-bottom: 8px solid transparent; }
  .wrap { padding: 10px 12px 0; }
  h1 { font-size: 16px; line-height: 1.3; font-weight: 700; }
  .ch { display: flex; align-items: center; gap: 9px; margin-top: 9px; }
  .ch .av { width: 34px; height: 34px; border-radius: 50%; background: url(/assets/posts/avatars/devon.jpg) center / cover; }
  .ch b { display: block; font-size: 13.5px; font-weight: 600; }
  .ch small { font-size: 11.5px; color: #606060; }
  .ch .sp { flex: 1; }
  .ch .sub { font-size: 12.5px; font-weight: 600; color: #fff; background: #0f0f0f; padding: 8px 13px; border-radius: 999px; }
  .ch .like { display: flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; background: #f2f2f2; padding: 8px 11px; border-radius: 999px; }
  .ch .like svg { width: 15px; height: 15px; }
  .desc { margin-top: 10px; background: #f2f2f2; border-radius: 12px; padding: 9px 11px; font-size: 12.5px; line-height: 1.45; }
  .desc b { font-weight: 600; }
  .desc a { color: #065fd4; }
  .desc .more { font-weight: 600; }
</style>
