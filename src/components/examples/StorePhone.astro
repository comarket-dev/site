---
/* An example co-branded storefront, open in Safari on a phone. Each brand's page is drawn in stores/ at a phone's real
   size (390 x 846 design pixels, the status bar and Safari's bar included) and scaled here to the width the page gives
   it: --sw, unitless. Fictional brand and creator, tagged as an example where it's shown. */
import { brand as getBrand, creator as getCreator, PAIRS } from '../../lib/examples';
import Fernwood from './stores/Fernwood.astro';
import Hollow from './stores/Hollow.astro';
import Kindred from './stores/Kindred.astro';
import Orbitly from './stores/Orbitly.astro';
import Pagewell from './stores/Pagewell.astro';
import Pingfield from './stores/Pingfield.astro';
import Quietly from './stores/Quietly.astro';
import Tallyhawk from './stores/Tallyhawk.astro';

interface Props {
  pair: number;
  tag?: boolean;
}
const { pair, tag = true } = Astro.props;
const p = PAIRS[pair % PAIRS.length];
const b = getBrand(p.brand);
const c = getCreator(p.creator);
const url = `${b.id}.comarket.si/creators/${c.id}`;

// each page, and whether its top is dark (white status bar) or light
const STORES: Record<string, { C: any; dark: boolean }> = {
  fernwood: { C: Fernwood, dark: false },
  tallyhawk: { C: Tallyhawk, dark: false },
  pagewell: { C: Pagewell, dark: false },
  orbitly: { C: Orbitly, dark: false },
  kindred: { C: Kindred, dark: false },
  hollow: { C: Hollow, dark: false },
  pingfield: { C: Pingfield, dark: true },
  quietly: { C: Quietly, dark: true },
};
const store = STORES[b.id];

// a minute or two after the post that sent them here, at a different moment of each day
const CLOCKS: Record<string, [string, number]> = {
  sarah: ['8:14', 0.82],
  theo: ['12:37', 0.54],
  lena: ['21:48', 0.31],
  imani: ['8:32', 0.86],
  devon: ['6:25', 0.38],
  alma: ['7:05', 0.92],
  mika: ['11:53', 0.29],
  jonah: ['3:41', 0.6],
};
const [clock, charge] = CLOCKS[c.id] ?? ['9:41', 0.8];
---

<article class="phone" aria-label={`Example storefront: ${b.name} with ${c.name}`}>
  <div class="bezel">
    <div class="screen">
      <div class="page"><store.C /></div>
      <div class:list={['sb', store.dark ? 'dark' : 'light']} aria-hidden="true">
        <span>{clock}</span>
        <span class="island"></span>
        <span class="r">
          <span class="bars"><i></i><i></i><i></i><i class:list={[{ off: charge < 0.5 }]}></i></span>
          <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0zM1 4.4a9.9 9.9 0 0 1 14 0l-1.4 1.4a7.9 7.9 0 0 0-11.2 0z"></path></svg>
          <span class:list={['batt', { low: charge < 0.2 }]}><b style={`width:${Math.round(charge * 100)}%`}></b></span>
        </span>
      </div>
      <!-- Safari's compact bar, floating over the page -->
      <div class="safari" aria-hidden="true">
        <span class="sbn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg></span>
        <span class="url">
          <svg class="lock" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10V8a5 5 0 0 1 10 0v2h.5A1.5 1.5 0 0 1 19 11.5v8a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19.5v-8A1.5 1.5 0 0 1 6.5 10zm2 0h6V8a3 3 0 0 0-6 0z"></path></svg>
          <span>{url}</span>
        </span>
        <span class="sbn"><svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5.5" cy="12" r="1.9"></circle><circle cx="12" cy="12" r="1.9"></circle><circle cx="18.5" cy="12" r="1.9"></circle></svg></span>
      </div>
      <span class="home" aria-hidden="true"></span>
    </div>
  </div>
  {tag && <span class="tag">Example</span>}
</article>

<style>
  .phone {
    position: relative;
    width: calc(var(--sw, 236) * 1px);
    flex: none;
  }
  .bezel {
    border-radius: calc(var(--sw, 236) * 0.165px);
    background: #0d0a14;
    padding: calc(var(--sw, 236) * 0.034px);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      0 40px 80px -40px rgb(30 14 63 / 0.55),
      0 12px 24px -12px rgb(30 14 63 / 0.35);
  }
  /* the screen at a phone's real size, zoomed to fit (zoom scales layout too, so the bezel wraps the scaled size) */
  .screen {
    zoom: calc(var(--sw, 236) * 0.932 / 390);
    position: relative;
    width: 390px;
    height: 846px;
    border-radius: 52px;
    overflow: hidden;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }
  .page {
    position: absolute;
    inset: 0;
  }

  /* iOS status bar */
  .sb {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 30px 0 40px;
    font: 600 15.5px/1 -apple-system, 'SF Pro Text', system-ui, sans-serif;
    z-index: 5;
  }
  .sb.dark {
    color: #fff;
  }
  .sb.light {
    color: #000;
  }
  .island {
    position: absolute;
    left: 50%;
    top: 11px;
    width: 122px;
    height: 35px;
    margin-left: -61px;
    border-radius: 20px;
    background: #000;
  }
  .sb .r {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 1.5px;
    height: 11px;
  }
  .bars i {
    width: 3px;
    border-radius: 1px;
    background: currentColor;
  }
  .bars i:nth-child(1) {
    height: 4px;
  }
  .bars i:nth-child(2) {
    height: 6px;
  }
  .bars i:nth-child(3) {
    height: 8.5px;
  }
  .bars i:nth-child(4) {
    height: 11px;
  }
  .bars i.off {
    opacity: 0.35;
  }
  .batt {
    position: relative;
    width: 25px;
    height: 12px;
    border-radius: 4px;
    border: 1px solid currentColor;
    padding: 1.5px;
    opacity: 0.9;
  }
  .batt::after {
    content: '';
    position: absolute;
    right: -3.5px;
    top: 3.5px;
    width: 2px;
    height: 4px;
    border-radius: 0 1px 1px 0;
    background: currentColor;
    opacity: 0.5;
  }
  .batt b {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: currentColor;
  }

  /* Safari's floating bar: back, the address, more */
  .safari {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 28px;
    height: 50px;
    display: flex;
    align-items: center;
    gap: 7px;
    z-index: 5;
    color: #1c1c1e;
    font-family: -apple-system, 'SF Pro Text', system-ui, sans-serif;
  }
  .safari > span {
    height: 50px;
    border-radius: 25px;
    background: rgb(249 249 251 / 0.86);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    backdrop-filter: blur(18px) saturate(1.6);
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.08),
      0 6px 20px -6px rgb(0 0 0 / 0.22);
  }
  .sbn {
    width: 46px;
    flex: none;
    display: grid;
    place-items: center;
  }
  .sbn svg {
    width: 21px;
    height: 21px;
  }
  .url {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0 10px;
    font-size: 13px;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .url span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lock {
    width: 11px;
    height: 11px;
    flex: none;
    opacity: 0.55;
  }
  .home {
    position: absolute;
    left: 50%;
    bottom: 8px;
    width: 136px;
    height: 5px;
    margin-left: -68px;
    border-radius: 3px;
    background: #000;
    z-index: 5;
  }

  .tag {
    position: absolute;
    top: -10px;
    right: 14px;
    font: 9.5px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 7px;
    border-radius: 999px;
    background: var(--paper, #f4f4f6);
    color: var(--graphite, #5e5873);
    border: 1px solid var(--rule, #d6d4de);
  }
</style>
