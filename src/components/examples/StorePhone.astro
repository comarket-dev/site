---
/* An example co-branded storefront on a phone. Fictional brand and creator, tagged as an example. */
import { brand as getBrand, creator as getCreator, PAIRS } from '../../lib/examples';
import Mark from './Mark.astro';

interface Props {
  pair: number;
  tag?: boolean;
}
const { pair, tag = true } = Astro.props;
const p = PAIRS[pair % PAIRS.length];
const b = getBrand(p.brand);
const c = getCreator(p.creator);
const url = `${b.id}.comarket.si/creators/${c.id}`;
// every phone caught at a different moment of someone's day
const CLOCKS = [
  ['8:14', 0.82],
  ['12:37', 0.54],
  ['7:02', 0.91],
  ['9:48', 0.67],
  ['6:25', 0.38],
  ['10:19', 0.73],
  ['11:53', 0.29],
  ['3:41', 0.6],
] as const;
const [clock, charge] = CLOCKS[pair % CLOCKS.length];
---

<article class="phone" style={`--brand:${b.color};--brand-ink:${b.ink};--tone:${c.tone}`} aria-label={`Example storefront: ${b.name} with ${c.name}`}>
  <div class="bezel">
    <div class="screen">
      <div class="status"><span>{clock}</span><span class="island"></span><span class="sig" style={`--charge:${charge}`}></span></div>
      <div class="addr">{url}</div>
      <div class="top">
        <span class="logo"><Mark kind={b.mark} /></span>
        <span class="lock">{b.name.toUpperCase()} <span class="x">×</span> {c.name.toUpperCase()}</span>
      </div>
      <div class="who">
        <span class="ava">{c.name[0]}</span>
        <span class="meta"><b>{c.handle}</b><span>{c.platform} · {c.audience}</span></span>
      </div>
      <h4>{p.headline}</h4>
      <p class="q">“{p.quote}”</p>
      <div class="prod">
        <div class="art"><Mark kind={b.mark} big /></div>
        <div class="pinfo"><b>{b.name}</b><span>{b.what}</span></div>
        <span class="price">{b.price}</span>
      </div>
      <div class="perk">{b.offer} with {c.name.split(' ')[0]}’s link</div>
      <span class="cta">{b.kind === 'saas' ? 'Start free trial' : 'Shop the routine'}</span>
      <span class="disc">{c.name.split(' ')[0]} earns a commission if you buy</span>
      <span class="pow">Storefront by Comarket</span>
    </div>
  </div>
  {tag && <span class="tag">Example</span>}
</article>

<style>
  .phone {
    position: relative;
    width: var(--w, 248px);
    aspect-ratio: 9 / 19;
    flex: none;
    font-family: var(--sans);
  }
  .bezel {
    position: absolute;
    inset: 0;
    border-radius: calc(var(--w, 248px) * 0.17);
    background: #0d0a14;
    padding: calc(var(--w, 248px) * 0.035);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      0 40px 80px -40px rgb(30 14 63 / 0.55),
      0 12px 24px -12px rgb(30 14 63 / 0.35);
  }
  .screen {
    position: relative;
    height: 100%;
    border-radius: calc(var(--w, 248px) * 0.14);
    overflow: hidden;
    background: #fff;
    color: #14121a;
    display: flex;
    flex-direction: column;
    gap: calc(var(--w, 248px) * 0.04);
    padding: calc(var(--w, 248px) * 0.05) calc(var(--w, 248px) * 0.06);
    font-size: calc(var(--w, 248px) * 0.048);
  }
  .status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 0.9em;
  }
  .island {
    width: 34%;
    height: 1.3em;
    border-radius: 999px;
    background: #0d0a14;
  }
  /* the battery, filled to this phone's charge */
  .sig {
    width: 1.6em;
    height: 0.7em;
    border-radius: 3px;
    border: 1.5px solid #14121a;
    background: linear-gradient(90deg, #14121a calc(var(--charge, 0.8) * 100%), transparent 0) content-box;
    padding: 1px;
  }
  .addr {
    font: 0.72em/1.2 var(--mono);
    color: #6f6a7a;
    background: #f3f2f6;
    border-radius: 999px;
    padding: 0.5em 0.8em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .logo {
    width: 1.8em;
    height: 1.8em;
    border-radius: 0.5em;
    background: var(--brand);
    color: var(--brand-ink);
    display: grid;
    place-items: center;
  }
  .lock {
    font: 0.66em/1 var(--mono);
    letter-spacing: 0.1em;
    color: var(--brand);
    filter: saturate(1.1) brightness(0.9);
  }
  .lock .x {
    opacity: 0.55;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .ava {
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    background: var(--tone);
    color: #14121a;
  }
  .meta {
    display: grid;
    line-height: 1.2;
  }
  .meta b {
    font-size: 0.9em;
  }
  .meta span {
    font-size: 0.72em;
    color: #6f6a7a;
  }
  h4 {
    margin: 0.2em 0 0;
    font-size: 1.45em;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  .q {
    margin: 0;
    font-size: 0.86em;
    line-height: 1.35;
    color: #3d3a46;
    padding-left: 0.7em;
    border-left: 2px solid var(--brand);
  }
  .prod {
    margin-top: auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.6em;
    align-items: center;
    padding: 0.6em;
    border: 1px solid #ecebf1;
    border-radius: 0.9em;
  }
  .art {
    width: 2.6em;
    height: 2.6em;
    border-radius: 0.6em;
    background: color-mix(in oklab, var(--brand) 18%, white);
    color: var(--brand);
    display: grid;
    place-items: center;
  }
  .pinfo {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }
  .pinfo b {
    font-size: 0.9em;
  }
  .pinfo span {
    font-size: 0.7em;
    color: #6f6a7a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .price {
    font: 0.82em var(--mono);
  }
  .perk {
    font-size: 0.76em;
    font-weight: 600;
    color: var(--brand);
    background: color-mix(in oklab, var(--brand) 10%, white);
    padding: 0.55em 0.7em;
    border-radius: 0.6em;
  }
  .cta {
    display: grid;
    place-items: center;
    height: 2.6em;
    border-radius: 999px;
    background: var(--brand);
    color: var(--brand-ink);
    font-weight: 600;
    font-size: 0.9em;
  }
  .disc {
    text-align: center;
    font-size: 0.7em;
    color: #6f6a7a;
    margin-top: -0.4em;
  }
  .pow {
    text-align: center;
    font: 0.6em var(--mono);
    letter-spacing: 0.08em;
    color: #a4a0ad;
    text-transform: uppercase;
  }
  .tag {
    position: absolute;
    top: -10px;
    right: 14px;
    font: 9.5px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 7px;
    border-radius: 999px;
    background: var(--paper, #f4f4f6);
    color: var(--graphite, #5e5873);
    border: 1px solid var(--rule, #d6d4de);
  }
</style>
