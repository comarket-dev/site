---
/* The same small footer on every example storefront: the creator's disclosure, then who made the page. It takes the
   page's own ink through --foot (default a neutral grey) so it sits quietly on any brand's colors. */
interface Props {
  first: string;
}
const { first } = Astro.props;
---

<div class="foot">
  <p>{first} earns a commission if you buy.</p>
  <p class="by">Storefront by <b>Comarket</b></p>
</div>

<style>
  .foot {
    display: grid;
    justify-items: center;
    gap: 3px;
    text-align: center;
    color: var(--foot, #6e6e73);
    font: 400 12px/1.3 -apple-system, 'SF Pro Text', system-ui, sans-serif;
  }
  p {
    margin: 0;
  }
  .by {
    font: 400 10.5px/1.2 var(--sans);
    letter-spacing: 0.01em;
    opacity: 0.8;
  }
  .by b {
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
