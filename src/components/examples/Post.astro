---
/* An example creator post carrying a storefront link, on the platform that creator uses. Each one is composed the
   way real posts are (platform layout, captions, the product's own UI) in posts/, at its design size, and scaled here
   to the width the page gives it: --pv for tall posts (TikTok, Instagram), --pwd for the rest. */
import { creator as getCreator, PAIRS } from '../../lib/examples';
import Ama from './posts/Ama.astro';
import Devon from './posts/Devon.astro';
import Jonah from './posts/Jonah.astro';
import Lena from './posts/Lena.astro';
import Mika from './posts/Mika.astro';
import Priya from './posts/Priya.astro';
import Sarah from './posts/Sarah.astro';
import Theo from './posts/Theo.astro';

interface Props {
  pair: number;
  tag?: boolean;
}
const { pair, tag = true } = Astro.props;
const p = PAIRS[pair % PAIRS.length];
const c = getCreator(p.creator);

const POSTS = {
  lena: { C: Lena, w: 360, h: 724 },
  ama: { C: Ama, w: 360, h: 724 },
  priya: { C: Priya, w: 360, h: 752 },
  devon: { C: Devon, w: 400, h: 452 },
  jonah: { C: Jonah, w: 400, h: 552 },
  sarah: { C: Sarah, w: 400, h: 640 },
  mika: { C: Mika, w: 400, h: 640 },
  theo: { C: Theo, w: 400, h: 600 },
} as const;
const post = POSTS[c.id as keyof typeof POSTS];
const vertical = post.w === 360;
---

<article class:list={['post', vertical ? 'vert' : 'wide']} style={`--dw:${post.w}`} aria-label={`Example ${c.platform} post by ${c.handle}, linking to their storefront`}>
  <div class="scale">
    <post.C />
  </div>
  {tag && <span class="tag">Example</span>}
</article>

<style>
  .post {
    position: relative;
    flex: none;
    --pw: var(--pwd, 300);
  }
  .vert {
    --pw: var(--pv, 230);
  }
  /* zoom scales layout too, so the card takes the scaled size; both numbers are unitless */
  .scale {
    zoom: calc(var(--pw) / var(--dw));
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #ecebf1;
    box-shadow: 0 40px 70px -40px rgb(30 14 63 / 0.5);
  }
  .vert .scale {
    border-radius: 34px;
    border: 0;
    background: #000;
  }
  /* under the post, so it never sits on the platform's own buttons */
  .tag {
    position: absolute;
    left: 50%;
    bottom: -26px;
    transform: translateX(-50%);
    color: var(--graphite);
    font: 400 10px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
