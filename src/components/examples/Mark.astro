---
/* Simple logo marks for the example brands. Invented shapes, not anyone's real logo. */
interface Props {
  kind: string;
  big?: boolean;
}
const { kind, big = false } = Astro.props;
const s = big ? '1.5em' : '1.05em';
---

<svg viewBox="0 0 24 24" width={s} height={s} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === 'leaf' && <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Zm0 0 7-7" />}
  {kind === 'hawk' && <path d="M3 12c4-1 6-4 9-7 1 4 4 6 9 7-5 1-8 3-9 7-1-4-4-6-9-7Z" />}
  {kind === 'page' && <path d="M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5" />}
  {kind === 'orbit' && <><circle cx="12" cy="12" r="3" /><ellipse cx="12" cy="12" rx="9" ry="4.5" /></>}
  {kind === 'drop' && <path d="M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11Z" />}
  {kind === 'leafcup' && <path d="M4 10h13v3a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6zM17 11h2a2 2 0 0 1 0 4h-2M9 7c0-2 2-3 3-4" />}
  {kind === 'stack' && <path d="M12 3 3 8l9 5 9-5zM3 13l9 5 9-5M3 17.5l9 5 9-5" />}
  {kind === 'moon' && <path d="M19 14A8 8 0 1 1 10 5a6 6 0 0 0 9 9Z" />}
</svg>
