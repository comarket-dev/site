---
/* Orbitly x Devon A., per design/brands/README.md: booking. A full-bleed Marigold top with the headline, the booking
   moment as the product (three calendars, one slot that works for all of them), Devon's note floating over its
   corner, one Umber button. Drawn at 390 x 846 design pixels (StorePhone.astro scales it). Fictional, an example. */
import BrandMark from '../BrandMark.astro';
import StoreFoot from '../StoreFoot.astro';

const DAYS = [
  ['Mon', '10'],
  ['Tue', '11'],
  ['Wed', '12'],
  ['Thu', '13'],
  ['Fri', '14'],
];
const SLOTS = ['9:30', '10:00', '1:15', '3:45'];
const TEAM = [
  ['MK', '#cfe3ff'],
  ['JS', '#ffd9c7'],
  ['AR', '#d6f0d8'],
];
---

<div class="root">
  <div class="top">
    <header class="lock">
      <span class="brand"><BrandMark id="orbitly" size="26" />orbitly</span>
      <span class="x">×</span>
      <span class="who"><span class="av"></span>Devon A.</span>
    </header>
    <h1>Book the call. Skip the email tag.</h1>
    <p class="sub">Scheduling for agencies and client teams. Devon’s viewers get 45&nbsp;days free.</p>
  </div>

  <!-- the booking link, open: everyone's calendar checked, one time that works -->
  <div class="book">
    <div class="b-head">
      <span class="team">
        {TEAM.map(([n, c]) => <span style={`background:${c}`}>{n}</span>)}
      </span>
      <span class="b-t"><b>Intro call with Northpeak</b><i>30 min · whoever’s free</i></span>
    </div>
    <div class="days">
      {
        DAYS.map(([d, n], i) => (
          <span class:list={[{ on: i === 2 }]}>
            <i>{d}</i>
            <b>{n}</b>
          </span>
        ))
      }
    </div>
    <div class="slots">
      {SLOTS.map((s, i) => <span class:list={[{ on: i === 1 }]}>{s}</span>)}
    </div>
    <p class="fits">10:00 works for all 3 calendars</p>
  </div>

  <figure class="note">
    <span class="av big"></span>
    <span>
      <blockquote>“I tested 6 scheduling tools. This is the one my team kept.”</blockquote>
      <figcaption>Devon A., Devon Builds on YouTube</figcaption>
    </span>
  </figure>

  <div class="buy">
    <span class="cta">Start my 45-day trial</span>
    <StoreFoot first="Devon" />
  </div>
</div>

<style>
  .root {
    --marigold: #f2b134;
    --umber: #2b1b00;
    --cream: #fff6e3;
    --foot: #7a6a4f;
    position: relative;
    height: 100%;
    background: var(--cream);
    color: var(--umber);
    font-family: 'Orbitly', system-ui, sans-serif;
    overflow: hidden;
  }
  .top {
    padding: 50px 22px 92px;
    background: var(--marigold);
  }
  .lock {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .brand,
  .who {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .x {
    font-size: 15px;
    font-weight: 500;
    opacity: 0.6;
  }
  .av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: url(/assets/posts/avatars/devon.jpg) center / cover;
    flex: none;
  }
  h1 {
    margin: 14px 0 0;
    font-size: 44px;
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .sub {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.38;
    font-weight: 500;
    color: #4d3a14;
    text-wrap: pretty;
  }

  /* the booking card, overlapping the edge of the Marigold */
  .book {
    position: relative;
    margin: -74px 16px 0;
    padding: 16px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 24px 40px -24px rgb(43 27 0 / 0.5);
  }
  .b-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* the team on a ring: who the link checks */
  .team {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    border: 1.5px dashed #e3cf9f;
  }
  .team span {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 9px;
    letter-spacing: -0.02em;
    font-weight: 700;
    border: 2px solid #fff;
  }
  .team span + span {
    margin-left: -8px;
  }
  .b-t {
    display: grid;
    gap: 1px;
  }
  .b-t b {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .b-t i {
    font-style: normal;
    font-size: 12px;
    color: #7a6a4f;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin-top: 14px;
  }
  .days span {
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 7px 0;
    border-radius: 12px;
    background: #fbf3e0;
  }
  .days i {
    font-style: normal;
    font-size: 10.5px;
    color: #7a6a4f;
  }
  .days b {
    font-size: 16px;
    font-weight: 700;
  }
  .days .on {
    background: var(--umber);
    color: var(--marigold);
  }
  .days .on i {
    color: #f7d58e;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 10px;
  }
  .slots span {
    padding: 9px 0;
    text-align: center;
    border-radius: 999px;
    border: 1.5px solid #e9dcbc;
    font-size: 13px;
    font-weight: 600;
  }
  .slots .on {
    border-color: var(--marigold);
    background: var(--marigold);
  }
  .fits {
    margin: 10px 2px 0;
    font-size: 12px;
    color: #7a6a4f;
  }

  /* Devon's note, floating over the card's corner */
  .note {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: -10px 30px 0 24px;
    padding: 12px 14px 12px 12px;
    border-radius: 16px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(43 27 0 / 0.06),
      0 14px 28px -16px rgb(43 27 0 / 0.45);
    transform: rotate(-1.5deg);
  }
  /* the creator's own photo beside their note (scripts/render-posts.py SHOTS), larger than the lockup's avatar */
  .av.big {
    width: 64px;
    height: 80px;
    border-radius: 10px;
    background-image: url(/assets/stores/creators/devon.jpg);
  }
  blockquote {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.28;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  figcaption {
    margin-top: 4px;
    font-size: 11.5px;
    color: #7a6a4f;
  }

  .buy {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 94px;
    display: grid;
    gap: 12px;
  }
  .cta {
    display: grid;
    place-items: center;
    height: 54px;
    border-radius: 999px;
    background: var(--umber);
    color: var(--marigold);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
