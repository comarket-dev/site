---
/* The persistent 3D stage. It survives page changes so the fork's phone can carry into a hero. */
---

<div id="stage" class="stage" transition:persist="stage" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .stage canvas {
    width: 100%;
    height: 100%;
    transition: opacity 0.5s var(--ease);
  }
  :global(.stage-off) .stage {
    display: none;
  }
</style>

<script>
  import type { Side, StageMode } from '../scripts/stage/stage';

  type StageApi = (typeof import('../scripts/stage/stage'))['stage'];
  let api: StageApi | null = null;
  let loading: Promise<StageApi | null> | null = null;
  let from: Side | undefined;

  function load(): Promise<StageApi | null> {
    if (!loading) {
      /* On a phone the poster already covers first paint, so three.js waits for the page to finish painting and the
         main thread to go quiet; a tap before then just goes to the page without the trip. */
      const idle = matchMedia('(pointer: coarse)').matches
        ? new Promise<void>((r) => {
            const go = () => ('requestIdleCallback' in window ? requestIdleCallback(() => r(), { timeout: 1500 }) : setTimeout(r, 300));
            if (document.readyState === 'complete') go();
            else addEventListener('load', go, { once: true });
          })
        : Promise.resolve();
      loading = idle
        .then(() => import('../scripts/stage/stage'))
        .then(({ stage }) => {
          const canvas = document.querySelector<HTMLCanvasElement>('#stage canvas');
          if (!canvas || !stage.init(canvas)) {
            document.documentElement.classList.add('stage-off');
            return null;
          }
          api = stage;
          (window as unknown as { __stage: StageApi }).__stage = stage;
          return stage;
        })
        .catch(() => {
          document.documentElement.classList.add('stage-off');
          return null;
        });
    }
    return loading;
  }

  /* The fork used to show the device and fly through its screen into a page (and back). Since 2026-10-29 the fork is
     two photos and its trips live in src/scripts/forktrip.ts; true brings the device trip back with a device fork. */
  const FORK_DEVICE = false;
  const motion = () => !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const onHero = () => document.body.dataset.stage === 'brands' || document.body.dataset.stage === 'creators';
  let returning = false;

  // going back to the fork from a hero: the hero is snapshotted as we leave, so its phone has to be in the page
  // itself (the poster) rather than only in the live canvas, or the page would shrink back into the screen without it
  document.addEventListener('astro:before-preparation', (e) => {
    const to = (e as Event & { to: URL }).to;
    returning = FORK_DEVICE && !!api && motion() && onHero() && to.pathname === '/' && 'startViewTransition' in document;
    if (returning) document.documentElement.classList.add('leaving');
  });

  // the swap copies <html> attributes from the incoming page, so hand it our state first;
  // otherwise the new page's poster flashes over the live device for a frame or two
  const keep = ['js', 'stage-live', 'stage-off', 'stage-drawn'];
  document.addEventListener('astro:before-swap', (e) => {
    const next = (e as Event & { newDocument: Document }).newDocument.documentElement;
    keep.forEach((c) => document.documentElement.classList.contains(c) && next.classList.add(c));
    // the device pick from Base.astro's inline script, which doesn't run again on a client-side page change
    const html = document.documentElement;
    if (html.dataset.device) next.dataset.device = html.dataset.device;
    const aspect = html.style.getPropertyValue('--device-aspect');
    if (aspect) next.style.setProperty('--device-aspect', aspect);
    const vt = (e as Event & { viewTransition?: ViewTransition }).viewTransition;
    if (!api || !motion() || !vt?.ready) return;
    if (returning) {
      returning = false;
      // the fork holds still around the device until it's home; the hero rides on top of it, inside the screen
      next.classList.add('landing', 'returning');
      vt.ready.then(placeReturn).catch(() => {});
      return;
    }
    if (!from) return;
    // the page we're travelling to is a still, composed, until we land on it (stage:landed)
    next.classList.add('landing');
    vt.ready.then(placePage).catch(() => {});
  });

  /** The view transition's layers, which Astro names after the page's transition scope rather than "root". */
  function layers() {
    const name = getComputedStyle(document.documentElement).viewTransitionName;
    const layer = !name || name === 'none' ? 'root' : name;
    return {
      old: { pseudoElement: `::view-transition-old(${layer})`, fill: 'both' as const },
      neu: { pseudoElement: `::view-transition-new(${layer})`, fill: 'both' as const },
    };
  }
  const paper = ['0 0 0 100vmax var(--paper)', '0 0 0 100vmax var(--paper)'];

  /* In: the next page under the device's screen, a true miniature that creeps in with it, then grows to full size.
     The fork stays as it was around the device. */
  function placePage() {
    const plan = api?.tripPlan();
    if (!plan) return;
    const html = document.documentElement;
    const { old, neu } = layers();
    const grow = html.animate(plan.keyframes, { ...neu, duration: plan.ms });
    // page colour in the hair between the page and the screen's page area, cut to that area
    const hair = html.animate({ clipPath: [plan.clip, plan.clip], boxShadow: paper }, { ...neu, duration: plan.ms });
    const hold = html.animate({ opacity: [1, 1] }, { ...old, duration: plan.ms });
    api?.syncTrip(grow);
    skippable([grow, hair, hold]);
  }

  /* Any tap, key or scroll during a trip lands at once: the stage reads its clock from these, so it lands too. */
  function skippable(anims: Animation[]) {
    const events = ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const;
    const skip = () => {
      off();
      anims.forEach((a) => {
        try {
          a.finish();
        } catch {}
      });
    };
    const off = () => events.forEach((t) => removeEventListener(t, skip, true));
    events.forEach((t) => addEventListener(t, skip, { capture: true, passive: true }));
    anims[0].finished.then(off, off);
  }

  /* Out: the page we're leaving shrinks back into the device's screen over the fork, then gives way to the demo. */
  function placeReturn() {
    const plan = api?.returnPlan();
    const html = document.documentElement;
    if (!plan) {
      html.classList.remove('landing', 'returning');
      return;
    }
    const { old, neu } = layers();
    const shrink = html.animate(plan.keyframes, { ...old, duration: plan.ms });
    const hair = html.animate({ clipPath: [plan.clip, plan.clip], boxShadow: paper }, { ...old, duration: plan.ms });
    const hold = html.animate({ opacity: [1, 1] }, { ...neu, duration: plan.ms });
    api?.syncTrip(shrink);
    skippable([shrink, hair, hold]);
  }

  async function apply() {
    const mode = (document.body.dataset.stage || 'none') as StageMode;
    const anchor = document.querySelector<HTMLElement>('[data-stage-anchor]');
    if (mode === 'none') {
      api?.setMode('none', null);
      // on the fork, fetch the 3D code while the visitor decides, so the side they pick draws its phone sooner
      if (location.pathname === '/' && !matchMedia('(pointer: coarse)').matches) {
        const warm = () => import('../scripts/stage/stage').catch(() => {});
        'requestIdleCallback' in window ? requestIdleCallback(warm, { timeout: 3000 }) : setTimeout(warm, 1500);
      }
      return;
    }
    const s = await load();
    if (!s) return;
    s.setMode(mode, anchor, { from });
    from = undefined;
    if (!anchor) return;
    // the device is a button: press whatever is on screen
    anchor.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a,button,input')) return;
      s.press();
    });
  }

  addEventListener('stage:hover', (e) => api?.hover((e as CustomEvent<Side | null>).detail));
  addEventListener('stage:choose', (e) => {
    const { side, done } = (e as CustomEvent<{ side: Side; done: () => void }>).detail;
    from = side;
    if (!api) return done();
    api.choose(side).then(done);
  });
  addEventListener('stage:landed', () => document.documentElement.classList.remove('landing', 'returning', 'leaving'));
  addEventListener('stage:brand', (e) => api?.setBrand((e as CustomEvent).detail));
  addEventListener('stage:creator', (e) => api?.setCreator((e as CustomEvent<string>).detail));
  // the device follows the window: Base.astro's inline script re-picks it and resizes its slot
  addEventListener('resize', () => (window as unknown as { cmDevice?: () => void }).cmDevice?.());

  document.documentElement.classList.add('js');
  document.addEventListener('astro:page-load', apply);
</script>
