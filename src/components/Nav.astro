---
import Icon from './Icon.astro';
interface Props {
  side: 'brands' | 'creators';
}
const { side } = Astro.props;
---

<header class="nav" data-nav>
  <a class="wm" href="/?fork=1" aria-label="Comarket, back to the start">Comarket</a>
  <nav class="switch" aria-label="Audience">
    <a href="/brands" aria-current={side === 'brands' ? 'page' : undefined}>Brands</a>
    <a href="/creators" aria-current={side === 'creators' ? 'page' : undefined}>Creators</a>
  </nav>
  <a class="btn join" href="#waitlist">{side === 'creators' ? 'Claim my page' : 'Get early access'} <Icon name="arrow-right" class="arr" /></a>
</header>

<style>
  .nav {
    position: fixed;
    z-index: 50;
    top: env(safe-area-inset-top, 0px);
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 14px var(--gr) 14px var(--gl);
    transition:
      background-color 0.4s var(--ease),
      backdrop-filter 0.4s var(--ease),
      border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-color: var(--rule);
  }
  .nav.on-dark {
    color: var(--paper);
  }
  .nav.on-dark.scrolled {
    background: color-mix(in oklab, var(--ink) 80%, transparent);
    border-color: var(--ink-rule);
  }
  .wm {
    justify-self: start;
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .switch {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid currentColor;
    border-color: color-mix(in oklab, currentColor 30%, transparent);
  }
  .switch a {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 999px;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .switch a[aria-current='page'] {
    background: var(--ink);
    color: var(--paper);
  }
  .nav.on-dark .switch a[aria-current='page'] {
    background: var(--paper);
    color: var(--ink);
  }
  .join {
    justify-self: end;
    --h: 42px;
    padding: 0 18px;
    font-size: 14px;
  }
  .nav.on-dark .join {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  @media (max-width: 720px) {
    .nav {
      grid-template-columns: auto 1fr;
    }
    .switch {
      justify-self: end;
    }
    .join {
      display: none;
    }
  }
</style>

<script>
  function bind() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!nav) return;
    const darks = Array.from(document.querySelectorAll<HTMLElement>('.band-ink'));
    const update = () => {
      nav.classList.toggle('scrolled', window.scrollY > 24);
      const y = 32;
      const dark = darks.some((d) => {
        const r = d.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      });
      nav.classList.toggle('on-dark', dark);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', update), { once: true });
  }
  document.addEventListener('astro:page-load', bind);
</script>
