---
import Icon from './Icon.astro';
import PhoneSlot from './PhoneSlot.astro';
import Steps from './Steps.astro';
import Person from './Person.astro';
import { hlClasses } from '../lib/hl';

interface Props {
  side: 'brands' | 'creators';
  title: string;
  mark: string;
  sub: string;
  placeholder: string;
  prefix?: string;
  button: string;
  last: string;
  label: string;
  /** the email step that opens once the phone shows the visitor's own page */
  join?: { button: string; fine?: string };
}
const { side, title, mark, sub, placeholder, prefix, button, last, label, join } = Astro.props;
const at = title.lastIndexOf(mark);
const [before, after] = at >= 0 ? [title.slice(0, at), title.slice(at + mark.length)] : [title, ''];
const brand = side === 'brands';
---

<section class="hero" data-hero data-side={side}>
  <div class="wrap inner">
    <div class="copy">
      <h1 class="title" data-reveal style="--d:.06s">
        {before}{at >= 0 && <mark class:list={['hl', { one: mark.length <= 18, ...hlClasses(mark) }]}>{mark}</mark>}{after}
      </h1>
      <p class="sub" data-reveal style="--d:.14s">{sub}</p>

      <form class="claim" data-claim={side} novalidate data-reveal style="--d:.22s">
        <label class="sr-only" for={`claim-${side}`}>{brand ? 'Your website' : 'Your handle'}</label>
        <div class="box">
          {prefix && <span class="pre num" aria-hidden="true">{prefix}</span>}
          <input
            id={`claim-${side}`}
            name="q"
            placeholder={placeholder}
            autocomplete={brand ? 'url' : 'username'}
            inputmode={brand ? 'url' : 'text'}
            autocapitalize="off"
            spellcheck="false"
            maxlength={brand ? 120 : 24}
            required
          />
          <button class="btn" type="submit" data-claim-btn>
            <span>{button}</span><Icon name="arrow-right" class="arr" />
          </button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
      </form>

      <form class="claim join" data-join novalidate hidden>
        <label class="sr-only" for={`join-${side}`}>{brand ? 'Work email' : 'Email'}</label>
        <div class="box">
          <input
            id={`join-${side}`}
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder={brand ? 'you@company.com' : 'you@email.com'}
            required
          />
          <button class="btn" type="submit" data-join-btn>
            <span>{join?.button ?? (brand ? 'Hold my spot' : 'Claim my page')}</span><Icon name="arrow-right" class="arr" />
          </button>
        </div>
        {join?.fine && <p class="fine">{join.fine}</p>}
      </form>

    </div>

    <div class="show" data-reveal style="--d:.1s">
      <!-- the person whose world this is; the phone stands in front of the photo's edge -->
      <div class="scene">
        <Person id={brand ? 'owner-hero' : 'creator-mic'} eager sizes="(max-width: 520px) 70vw, (max-width: 960px) 46vw, 460px" />
      </div>
      <PhoneSlot class="phone" poster={`/assets/stage/poster-${side}.webp`} label={label} />
      <Steps last={last} class="steps compact" />
    </div>
  </div>
</section>

<style>
  /* The stage's canvas (z-index 1) draws the phone. The hero's copy and tracker sit above it; the photo sits under
     it, so the phone stands in front of the person. */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    /* clip sideways only (the poster overhangs); shadows may spill into the next section */
    overflow-x: clip;
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 6vw, 112px);
    padding-top: clamp(96px, 13vh, 140px);
    padding-bottom: clamp(40px, 7vh, 88px);
  }
  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 720px;
  }
  .title {
    font-size: clamp(38px, 4.4vw, 68px);
    line-height: 1.16;
    letter-spacing: -0.045em;
    font-weight: 700;
    max-width: 17ch;
  }
  mark.one {
    white-space: nowrap;
  }
  .sub {
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--graphite);
    max-width: 44ch;
  }

  .claim {
    width: 100%;
    max-width: 560px;
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .box {
    display: flex;
    align-items: center;
    height: 64px;
    padding: 6px 6px 6px 20px;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--rule);
    box-shadow: 0 1px 0 rgb(30 14 63 / 0.04), 0 18px 40px -24px rgb(30 14 63 / 0.35);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .box:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(0 110 184 / 0.14), 0 18px 40px -24px rgb(30 14 63 / 0.35);
  }
  .pre {
    color: var(--graphite);
    font-size: 15px;
    white-space: nowrap;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 17px;
    letter-spacing: -0.01em;
    outline: none;
  }
  .pre + input {
    font-family: var(--mono);
    font-size: 15px;
    padding-left: 1px;
  }
  input::placeholder {
    color: var(--ghost);
  }
  .claim .btn {
    --h: 52px;
    flex: none;
  }
  .result {
    min-height: 1.4em;
    padding-left: 20px;
    font-size: 14.5px;
    color: var(--graphite);
  }
  .result :global(a) {
    color: var(--blue);
    font-weight: 600;
  }
  .result.err {
    color: var(--ink);
    font-weight: 600;
  }
  .result:empty {
    display: none;
  }
  /* the email step slides in right under the line that offered it */
  .join {
    margin-top: -14px;
    animation: join-in 0.35s var(--ease) both;
  }
  .join[hidden] {
    display: none;
  }
  @keyframes join-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .fine {
    padding-left: 20px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--graphite);
    max-width: 52ch;
  }

  .copy,
  .show :global(.steps) {
    position: relative;
    z-index: 2;
  }
  /* the phone (--ph tall) in front of the left edge of the person's photo, the step tracker under both */
  .show {
    --ph: max(380px, min(68vh, 640px));
    display: grid;
    grid-template-columns: auto auto;
    grid-template-areas:
      'phone scene'
      'steps steps';
    align-items: center;
    justify-content: end;
    row-gap: 14px;
  }
  .show :global(.slot) {
    grid-area: phone;
    height: var(--ph);
    z-index: 1;
  }
  .scene {
    grid-area: scene;
    position: relative;
    height: calc(var(--ph) * 0.84);
    aspect-ratio: 4 / 5;
    margin-left: calc(var(--ph) * -0.2);
    border-radius: 28px;
    overflow: hidden;
    background: var(--rule);
  }
  .scene :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show :global(.steps) {
    grid-area: steps;
    justify-self: center;
    max-width: 380px;
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 92px;
      gap: 40px;
    }
    .title {
      font-size: clamp(34px, 9vw, 60px);
    }
    .show {
      --ph: max(340px, min(62svh, 560px));
      justify-content: center;
    }
  }
  @media (max-width: 520px) {
    .box {
      height: auto;
      flex-wrap: wrap;
      padding: 6px;
      border-radius: 22px;
      gap: 6px;
    }
    .pre {
      padding-left: 12px;
    }
    input {
      height: 50px;
      padding-left: 12px;
    }
    .pre + input {
      padding-left: 0;
    }
    .claim .btn {
      width: 100%;
    }
    .result {
      padding-left: 4px;
    }
    /* phone and photo side by side still, smaller, inside a 358px column */
    .show {
      --ph: min(54svh, 400px);
    }
    .scene {
      height: calc(var(--ph) * 0.8);
      aspect-ratio: 3 / 4;
      border-radius: 22px;
    }
  }
</style>

<script>
  import { onPage, track } from '../scripts/ui';
  import { iconHtml } from '../lib/icons';

  interface Preview {
    host: string;
    name: string;
    color: string | null;
    icon: string | null;
  }
  type JoinResult = { ok: true; passNo: number } | { ok: false; error: string };

  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-claim]');
    if (!form) return;
    const side = form.dataset.claim as 'brands' | 'creators';
    const input = form.querySelector<HTMLInputElement>('input')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-claim-btn]')!;
    const out = form.querySelector<HTMLElement>('[data-result]')!;
    const phone = document.querySelector<HTMLElement>('[data-hero] [data-stage-anchor]');
    const COPY = {
      brand: 'That’s {name} on Sarah’s storefront. Hold your spot and we’ll build the real one.',
      free: '{page} is free. Claim it before someone else does.',
      unknown: 'That’s {page} on the phone. Claim it now.',
      done: side === 'brands' ? 'You’re No. {no}. We’ll email you once, when your spot opens.' : '{page} is yours. You’re No. {no}.',
      pass: 'See my pass',
    };

    const say = (html: string, err = false) => {
      out.innerHTML = html;
      out.classList.toggle('err', err);
    };
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const join = document.querySelector<HTMLFormElement>('[data-join]');
    const joinInput = join?.querySelector<HTMLInputElement>('input') ?? null;
    const joinBtn = join?.querySelector<HTMLButtonElement>('[data-join-btn]') ?? null;
    const narrow = () => matchMedia('(max-width: 960px)').matches;
    const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');
    /* Show the visitor their page. Side by side, that's the phone; stacked, the line and the email step go just under
       the nav with the phone right below them, so the offer, the field and the page they're for all stay in view. */
    const reveal = () => {
      if (narrow()) {
        const nav = document.querySelector<HTMLElement>('[data-nav]');
        const top = out.getBoundingClientRect().top + scrollY - (nav?.offsetHeight ?? 64) - 14;
        if (Math.abs(top - scrollY) > 8) scrollTo({ top, behavior: smooth() });
        return;
      }
      if (!phone) return;
      const r = phone.getBoundingClientRect();
      if (r.top < 60 || r.bottom > innerHeight) phone.scrollIntoView({ behavior: smooth(), block: 'center' });
    };
    /* one primary button on screen at a time: while the email step is open, the field above steps back and says
       what it does now */
    const btnLabel = btn.querySelector('span')!;
    const label0 = btnLabel.textContent;
    const openJoin = () => {
      if (!join) return;
      join.hidden = false;
      btn.classList.add('ghost');
      btnLabel.textContent = side === 'brands' ? 'Try another site' : 'Try another';
      if (!narrow()) joinInput?.focus({ preventScroll: true });
    };
    const closeJoin = () => {
      if (join) join.hidden = true;
      btn.classList.remove('ghost');
      btnLabel.textContent = label0;
    };
    /* hand the value to the waitlist form further down so nobody types it twice; the latest one typed here wins */
    const prefill = (name: string, value: string) => {
      const f = document.querySelector<HTMLInputElement>(`[data-waitlist] [name="${name}"]`);
      if (!f) return;
      f.value = value;
      f.dispatchEvent(new Event('input', { bubbles: true }));
      f.dispatchEvent(new Event('change', { bubbles: true }));
    };

    const onSubmit = async (e: SubmitEvent) => {
      e.preventDefault();
      const q = input.value.trim();
      if (side === 'creators') {
        const h = q.replace(/^@+/, '').toLowerCase().replace(/[^a-z0-9._]/g, '').replace(/^[._]+|[._]+$/g, '').slice(0, 24);
        if (h.length < 2) {
          closeJoin();
          return say('Use at least two letters or numbers.', true);
        }
        input.value = h;
        dispatchEvent(new CustomEvent('stage:creator', { detail: h }));
        btn.disabled = true;
        let free: boolean | null = null;
        try {
          const r = await fetch(`/api/handle?h=${encodeURIComponent(h)}`);
          free = r.ok ? ((await r.json()) as { available: boolean | null }).available : null;
        } catch {
          free = null;
        } finally {
          btn.disabled = false;
        }
        track('hero_claim', { side: 'creator', free });
        if (free === false) {
          closeJoin();
          say(`<b>comarket.si/${esc(h)}</b> is taken. Try another.`, true);
          reveal();
          return;
        }
        prefill('handle', h);
        say(free ? COPY.free.replace('{page}', `<b>comarket.si/${esc(h)}</b>`) : COPY.unknown.replace('{page}', `<b>comarket.si/${esc(h)}</b>`));
        openJoin();
        reveal();
        return;
      }
      if (!q) {
        closeJoin();
        return say('Enter your website, like yourapp.com.', true);
      }
      btn.disabled = true;
      say('Reading your site…');
      try {
        const res = await fetch('/api/preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ site: q }),
        });
        const data = (await res.json()) as Preview & { error?: string };
        if (!res.ok) {
          say(esc(data.error || 'We couldn’t read that site.'), true);
          return;
        }
        dispatchEvent(
          new CustomEvent('stage:brand', {
            detail: { name: data.name, color: data.color, host: data.host, icon: data.icon ? `/api/icon?host=${encodeURIComponent(data.host)}` : null },
          }),
        );
        prefill('site', q);
        say(COPY.brand.replace('{name}', `<b>${esc(data.name)}</b>`));
        track('hero_claim', { side: 'brand', host: data.host });
        openJoin();
        reveal();
      } catch {
        say('We couldn’t reach that site. Check the address.', true);
      } finally {
        btn.disabled = false;
      }
    };

    /* The email step: the same signup as the form at the bottom (waitlist.ts does the work), without the trip there. */
    const onJoin = async (e: SubmitEvent) => {
      e.preventDefault();
      if (!joinInput || !joinBtn) return;
      const email = joinInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) return say('Enter a valid email address.', true);
      if (!document.querySelector('[data-waitlist]')) {
        location.hash = 'waitlist';
        return;
      }
      joinBtn.disabled = true;
      const label = joinBtn.innerHTML;
      joinBtn.textContent = 'Joining…';
      const r = await new Promise<JoinResult>((done) => dispatchEvent(new CustomEvent('waitlist:join', { detail: { email, done } })));
      joinBtn.disabled = false;
      joinBtn.innerHTML = label;
      if (!r.ok) return say(esc(r.error), true);
      if (join) join.hidden = true;
      const no = String(r.passNo).padStart(4, '0');
      const page = `<b>comarket.si/${esc(input.value.trim())}</b>`;
      say(`${COPY.done.replace('{no}', no).replace('{page}', page)} <a href="#waitlist">${COPY.pass} ${iconHtml('arrow-right')}</a>`);
    };

    form.addEventListener('submit', onSubmit);
    join?.addEventListener('submit', onJoin);
    return [
      () => form.removeEventListener('submit', onSubmit),
      () => join?.removeEventListener('submit', onJoin),
    ];
  });
</script>
