---
import Icon from './Icon.astro';
import PhoneSlot from './PhoneSlot.astro';
import Steps from './Steps.astro';
import { hlClasses } from '../lib/hl';

interface Props {
  side: 'brands' | 'creators';
  title: string;
  mark: string;
  sub: string;
  placeholder: string;
  prefix?: string;
  button: string;
  last: string;
  label: string;
}
const { side, title, mark, sub, placeholder, prefix, button, last, label } = Astro.props;
const at = title.lastIndexOf(mark);
const [before, after] = at >= 0 ? [title.slice(0, at), title.slice(at + mark.length)] : [title, ''];
const brand = side === 'brands';
---

<section class="hero" data-hero data-side={side}>
  <div class="wrap inner">
    <div class="copy">
      <h1 class="title" data-reveal style="--d:.06s">
        {before}{at >= 0 && <mark class:list={['hl', { one: mark.length <= 18, ...hlClasses(mark) }]}>{mark}</mark>}{after}
      </h1>
      <p class="sub" data-reveal style="--d:.14s">{sub}</p>

      <form class="claim" data-claim={side} novalidate data-reveal style="--d:.22s">
        <label class="sr-only" for={`claim-${side}`}>{brand ? 'Your website' : 'Your handle'}</label>
        <div class="box">
          {prefix && <span class="pre num" aria-hidden="true">{prefix}</span>}
          <input
            id={`claim-${side}`}
            name="q"
            placeholder={placeholder}
            autocomplete={brand ? 'url' : 'username'}
            inputmode={brand ? 'url' : 'text'}
            autocapitalize="off"
            spellcheck="false"
            maxlength={brand ? 120 : 24}
            required
          />
          <button class="btn" type="submit" data-claim-btn>
            <span>{button}</span><Icon name="arrow-right" class="arr" />
          </button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
      </form>

    </div>

    <div class="show" data-reveal style="--d:.1s">
      <PhoneSlot class="phone" poster={`/assets/stage/poster-${side}.webp`} label={label} />
      <Steps last={last} class="steps compact" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: center;
    /* clip sideways only (the poster overhangs); shadows may spill into the next section */
    overflow-x: clip;
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 6vw, 112px);
    padding-top: clamp(96px, 13vh, 140px);
    padding-bottom: clamp(40px, 7vh, 88px);
  }
  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 720px;
  }
  .title {
    font-size: clamp(38px, 4.4vw, 68px);
    line-height: 1.16;
    letter-spacing: -0.045em;
    font-weight: 700;
    max-width: 17ch;
  }
  mark.one {
    white-space: nowrap;
  }
  .sub {
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--graphite);
    max-width: 44ch;
  }

  .claim {
    width: 100%;
    max-width: 560px;
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }
  .box {
    display: flex;
    align-items: center;
    height: 64px;
    padding: 6px 6px 6px 20px;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--rule);
    box-shadow: 0 1px 0 rgb(30 14 63 / 0.04), 0 18px 40px -24px rgb(30 14 63 / 0.35);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .box:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(0 110 184 / 0.14), 0 18px 40px -24px rgb(30 14 63 / 0.35);
  }
  .pre {
    color: var(--graphite);
    font-size: 15px;
    white-space: nowrap;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    font-size: 17px;
    letter-spacing: -0.01em;
    outline: none;
  }
  .pre + input {
    font-family: var(--mono);
    font-size: 15px;
    padding-left: 1px;
  }
  input::placeholder {
    color: var(--ghost);
  }
  .claim .btn {
    --h: 52px;
    flex: none;
  }
  .result {
    min-height: 1.4em;
    padding-left: 20px;
    font-size: 14.5px;
    color: var(--graphite);
  }
  .result :global(a) {
    color: var(--blue);
    font-weight: 600;
  }
  .result.err {
    color: var(--ink);
    font-weight: 600;
  }

  .show {
    display: grid;
    justify-items: center;
    gap: 14px;
  }
  .show :global(.slot) {
    height: min(68vh, 640px);
    min-height: 380px;
  }
  .show :global(.steps) {
    max-width: 380px;
  }

  @media (max-width: 960px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 92px;
      gap: 40px;
    }
    .title {
      font-size: clamp(34px, 9vw, 60px);
    }
    .show :global(.slot) {
      height: min(62svh, 560px);
      min-height: 340px;
    }
  }
  @media (max-width: 520px) {
    .box {
      height: auto;
      flex-wrap: wrap;
      padding: 6px;
      border-radius: 22px;
      gap: 6px;
    }
    .pre {
      padding-left: 12px;
    }
    input {
      height: 50px;
      padding-left: 12px;
    }
    .pre + input {
      padding-left: 0;
    }
    .claim .btn {
      width: 100%;
    }
    .result {
      padding-left: 4px;
    }
  }
</style>

<script>
  import { onPage, track } from '../scripts/ui';
  import { iconHtml } from '../lib/icons';

  interface Preview {
    host: string;
    name: string;
    color: string | null;
    icon: string | null;
  }

  onPage(() => {
    const form = document.querySelector<HTMLFormElement>('[data-claim]');
    if (!form) return;
    const side = form.dataset.claim as 'brands' | 'creators';
    const input = form.querySelector<HTMLInputElement>('input')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-claim-btn]')!;
    const out = form.querySelector<HTMLElement>('[data-result]')!;
    const phone = document.querySelector<HTMLElement>('[data-hero] [data-stage-anchor]');

    const say = (html: string, err = false) => {
      out.innerHTML = html;
      out.classList.toggle('err', err);
    };
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    const reveal = () => {
      if (!phone) return;
      const r = phone.getBoundingClientRect();
      if (r.top < 60 || r.bottom > innerHeight) phone.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    /* hand the value to the waitlist form further down so nobody types it twice */
    const prefill = (name: string, value: string) => {
      const f = document.querySelector<HTMLInputElement>(`[data-waitlist] [name="${name}"]`);
      if (!f || f.value) return;
      f.value = value;
      f.dispatchEvent(new Event('input', { bubbles: true }));
      f.dispatchEvent(new Event('change', { bubbles: true }));
    };

    const onSubmit = async (e: SubmitEvent) => {
      e.preventDefault();
      const q = input.value.trim();
      if (side === 'creators') {
        const h = q.replace(/^@+/, '').toLowerCase().replace(/[^a-z0-9._]/g, '').replace(/^[._]+|[._]+$/g, '').slice(0, 24);
        if (h.length < 2) return say('Use at least two letters or numbers.', true);
        input.value = h;
        dispatchEvent(new CustomEvent('stage:creator', { detail: h }));
        reveal();
        btn.disabled = true;
        let free: boolean | null = null;
        try {
          const r = await fetch(`/api/handle?h=${encodeURIComponent(h)}`);
          free = r.ok ? ((await r.json()) as { available: boolean | null }).available : null;
        } catch {
          free = null;
        } finally {
          btn.disabled = false;
        }
        track('hero_claim', { side: 'creator', free });
        if (free === false) return say(`<b>comarket.si/${esc(h)}</b> is taken. Try another.`, true);
        prefill('handle', h);
        say(
          free
            ? `<b>comarket.si/${esc(h)}</b> is free. <a href="#waitlist">Claim it before someone else does ${iconHtml('arrow-right')}</a>`
            : `That’s <b>comarket.si/${esc(h)}</b> on the phone. <a href="#waitlist">Claim it ${iconHtml('arrow-right')}</a>`,
        );
        return;
      }
      if (!q) return say('Enter your website, like yourapp.com.', true);
      btn.disabled = true;
      say('Reading your site…');
      try {
        const res = await fetch('/api/preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ site: q }),
        });
        const data = (await res.json()) as Preview & { error?: string };
        if (!res.ok) {
          say(esc(data.error || 'We couldn’t read that site.'), true);
          return;
        }
        dispatchEvent(
          new CustomEvent('stage:brand', {
            detail: { name: data.name, color: data.color, host: data.host, icon: data.icon ? `/api/icon?host=${encodeURIComponent(data.host)}` : null },
          }),
        );
        prefill('site', q);
        say(`That’s <b>${esc(data.name)}</b> on a creator’s storefront. <a href="#waitlist">Get early access to make it real ${iconHtml('arrow-right')}</a>`);
        track('hero_claim', { side: 'brand', host: data.host });
        reveal();
      } catch {
        say('We couldn’t reach that site. Check the address.', true);
      } finally {
        btn.disabled = false;
      }
    };
    form.addEventListener('submit', onSubmit);
    return [() => form.removeEventListener('submit', onSubmit)];
  });
</script>
