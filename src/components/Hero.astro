---
interface Props {
  side: 'brands' | 'creators';
  eyebrow: string;
  title: string;
  host: string;
  path: string;
  slugs: string[];
  note: string;
  next: string;
}
const { side, eyebrow, title, host, path, slugs, note, next } = Astro.props;
---

<section class="hero" data-hero data-side={side}>
  <div class="wrap inner">
    <div class="copy">
      <span class="label" data-reveal>{eyebrow}</span>
      <h1 class="display-xl" data-reveal style="--d:.08s">{title}</h1>
      <div class="url num" data-reveal style="--d:.18s" aria-label={`Example address: ${host}${path}${slugs[0]}`}>
        <span class="host">{host}</span><span class="path">{path}</span><span class="slug" data-cycle={slugs.join(',')}
          >{slugs[0]}</span
        ><span class="caret" aria-hidden="true"></span>
      </div>
      <div class="cta" data-reveal style="--d:.26s">
        <a class="btn" href="#waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <span class="label note">{note}</span>
      </div>
    </div>
  </div>
  <a class="scroll label" href={next}>Scroll</a>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-bottom: clamp(56px, 9vh, 120px);
  }
  .inner {
    padding-top: 120px;
  }
  .copy {
    display: grid;
    gap: 28px;
    max-width: min(1000px, 62vw);
  }
  h1 {
    max-width: 11ch;
  }
  .url {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    height: 48px;
    padding: 0 18px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: clamp(13px, 1.25vw, 16px);
    white-space: nowrap;
    overflow: hidden;
  }
  .host,
  .path {
    color: var(--graphite);
  }
  .slug {
    color: var(--ink);
  }
  .caret {
    width: 1.5px;
    height: 1.2em;
    margin-left: 2px;
    background: var(--ink);
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }
  .scroll {
    position: absolute;
    right: var(--gr);
    bottom: calc(28px + env(safe-area-inset-bottom, 0px));
    text-decoration: none;
    writing-mode: vertical-rl;
    letter-spacing: 0.2em;
  }
  @media (max-width: 860px) {
    .copy {
      max-width: none;
    }
    .hero {
      align-items: end;
    }
    .scroll {
      display: none;
    }
  }
</style>

<script>
  import { cycleWords, onPage } from '../scripts/ui';
  onPage(() => {
    const el = document.querySelector<HTMLElement>('[data-hero] [data-cycle]');
    return el ? [cycleWords(el, (el.dataset.cycle || '').split(','))] : [];
  });
</script>
