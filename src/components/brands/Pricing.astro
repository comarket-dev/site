---
import type { PriceArm } from '../../lib/pricing';
interface Props {
  arm: PriceArm;
}
const { arm } = Astro.props;
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-h">
  <div class="wrap">
    <div class="step-head">
      <span class="label">Pricing</span>
      <h2 class="sr-only" id="pricing-h">Pricing</h2>
    </div>
    <div class="nums">
      <div class="n" data-reveal>
        <b>$0</b>
        <span class="label">upfront, and nothing monthly</span>
      </div>
      <div class="n" data-reveal style="--d:.1s">
        <b>{arm.first}<span class="pct">%</span></b>
        <span class="label">of a new customer’s first payment</span>
      </div>
      <div class="n" data-reveal style="--d:.2s">
        <b>{arm.after}<span class="pct">%</span></b>
        <span class="label">of each payment after that</span>
      </div>
    </div>
    <div class="under">
      <p class="lede">Creators earn the rate you set. Customers you already had cost you nothing.</p>
      <div class="stack">
        <a class="btn tilt a" href="#waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn ghost tilt b" href="/creators">See the creator side</a>
      </div>
    </div>
  </div>
</section>

<style>
  .nums {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }
  .n {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: clamp(20px, 3vw, 36px) clamp(12px, 2vw, 28px) clamp(28px, 4vw, 48px) 0;
    border-right: 1px solid var(--rule);
  }
  .n + .n {
    padding-left: clamp(12px, 2vw, 28px);
  }
  .n:last-child {
    border-right: 0;
  }
  .n b {
    font-size: clamp(88px, 15vw, 260px);
    line-height: 0.82;
    letter-spacing: -0.065em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .pct {
    font-size: 0.45em;
    letter-spacing: -0.03em;
    vertical-align: 0.95em;
    margin-left: 0.04em;
  }
  .under {
    margin-top: clamp(40px, 6vw, 80px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .stack {
    position: relative;
    display: grid;
    justify-items: end;
    gap: 0;
  }
  .tilt {
    --h: 72px;
    padding: 0 34px;
    font-size: 20px;
    transition: transform 0.6s var(--ease);
  }
  .tilt.a {
    transform: rotate(-4deg);
    z-index: 2;
  }
  .tilt.b {
    transform: rotate(3deg) translate(-24px, -8px);
    background: var(--paper);
  }
  .tilt:hover {
    transform: rotate(0deg) translateY(-3px);
  }
  @media (max-width: 760px) {
    .nums {
      grid-template-columns: minmax(0, 1fr);
    }
    .n,
    .n + .n {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding-left: 0;
    }
    .stack {
      justify-items: start;
    }
    .tilt {
      --h: 60px;
      font-size: 17px;
    }
  }
</style>
