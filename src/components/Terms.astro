---
/* The deal, in plain words, right under the hero. People said the money terms were the first thing they went looking for. */
interface Props {
  title: string;
  items: Array<{ h: string; p: string }>;
}
const { title, items } = Astro.props;
---

<section class="section terms" aria-labelledby="terms-h">
  <div class="wrap">
    <div class="head">
      <h2 class="display-m" id="terms-h" data-reveal>{title}</h2>
    </div>
    <ol class="cards">
      {
        items.map((it, i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}>
            <b>{it.h}</b>
            <p>{it.p}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .terms {
    padding-block: clamp(56px, 7vw, 112px);
    background: var(--white);
    border-block: 1px solid var(--rule);
  }
  .head {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }
  .head h2 {
    max-width: 22ch;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .cards li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 22px 20px 24px;
    border-radius: 22px;
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .cards b {
    font-size: clamp(19px, 1.5vw, 22px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .cards li:first-child {
    background: var(--yellow);
    border-color: var(--ink);
  }
  .cards li:first-child p {
    color: var(--ink);
  }
  .cards p {
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--graphite);
  }
  @media (max-width: 1080px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
