---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Doc from '../components/legal/Doc.astro';
import { requiresConsent } from '../lib/consent';
const updated = '30 October 2026';
// Shows a draft note and keeps the page out of search until the placeholders are filled (design/legal/README.md).
const draft = true;

// Mirrors src/middleware.ts: visitors where we ask first can change their choice here; elsewhere analytics are on.
const ask = requiresConsent(Astro.locals.country);
const chosen = Astro.cookies.get('cm_consent')?.value;
const state = chosen === '1' ? 'on' : chosen === '0' ? 'off' : 'unset';
---

<Base title="Cookie policy · Comarket" description="Every cookie comarket.si sets, what each is for, how long it lasts, and how to change your choice." stage="none" noindex={draft}>
  <Doc
    title="Cookie policy"
    lede="Four cookies of our own, plus Cloudflare's security checks. No advertising cookies, no third-party analytics."
    updated={updated}
    draft={draft}
    current="/cookies"
    toc={false}
  >
    <h2>When we set them</h2>
    <p>
      In the EU, the EEA, the UK and Switzerland, and when we can't tell where a visit comes from, we set no analytics cookie
      until you choose "Allow". Everywhere else, analytics cookies are on. To block them there, block cookies for comarket.si
      in your browser settings.
    </p>
    {
      ask && (
        <div class="short" id="cookie-choice">
          <p data-status>
            {state === 'on' && 'Analytics are on for this browser.'}
            {state === 'off' && 'Analytics are off for this browser.'}
            {state === 'unset' && 'You haven’t chosen yet, so analytics are off.'}
          </p>
          <div class="choice-row">
            <button type="button" class="btn ghost" data-set="0">Turn analytics off</button>
            <button type="button" class="btn" data-set="1">Allow analytics</button>
          </div>
        </div>
      )
    }

    <h2>Our cookies</h2>
    <div class="tbl">
      <table>
        <thead>
          <tr><th>Name</th><th>What it does</th><th>Set when</th><th>Lasts</th></tr>
        </thead>
        <tbody>
          <tr>
            <td><code>cm_consent</code></td>
            <td>Remembers your analytics choice</td>
            <td>You choose</td>
            <td>180 days</td>
          </tr>
          <tr>
            <td><code>cm_vid</code></td>
            <td>A random visitor ID that links page versions and simple events, so we can tell which pages work. No name, email or IP address</td>
            <td>Analytics are on</td>
            <td>1 year</td>
          </tr>
          <tr>
            <td><code>cm_x_pricing_v1</code></td>
            <td>Keeps the version of the brands page you were shown in a pricing test, so it stays the same and the rates you saw are recorded if you join</td>
            <td>You open the brands page with analytics on</td>
            <td>180 days</td>
          </tr>
          <tr>
            <td><code>cm_side</code></td>
            <td>Remembers whether you chose the brands or creators page, so the home page takes you back there</td>
            <td>You open either page with analytics on</td>
            <td>180 days</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Turning analytics off deletes <code>cm_vid</code> and <code>cm_side</code> and stops new events. Events already recorded
      stay until their 13 months are up; email [[CONTACT EMAIL]] to have them deleted sooner.
    </p>

    <h2>Cloudflare</h2>
    <p>
      Our host, Cloudflare, may set short-lived security cookies (such as <code>__cf_bm</code> and <code>cf_clearance</code>) to
      stop attacks, and its Turnstile bot check on our signup form reads browser signals to tell people from bots. These are
      needed for the site to work and aren't used for advertising.
    </p>
  </Doc>
  <Footer />
</Base>

<style>
  .choice-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .choice-row .btn {
    --h: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
</style>

<script>
  const TEXT: Record<string, string> = {
    '1': 'Analytics are on for this browser.',
    '0': 'Analytics are off for this browser.',
  };
  function bind() {
    const box = document.getElementById('cookie-choice');
    if (!box || box.dataset.bound) return;
    box.dataset.bound = '1';
    const status = box.querySelector<HTMLElement>('[data-status]')!;
    box.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) =>
      b.addEventListener('click', async () => {
        const value = b.dataset.set!;
        try {
          const res = await fetch('/api/consent', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ value }),
          });
          if (!res.ok) throw new Error(String(res.status));
          status.textContent = TEXT[value];
          // the banner, if it's open, has nothing left to ask
          const banner = document.getElementById('consent');
          if (banner) banner.hidden = true;
        } catch {
          status.textContent = 'That didn’t save. Check your connection and try again.';
        }
      }),
    );
  }
  document.addEventListener('astro:page-load', bind);
</script>
