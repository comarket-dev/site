---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import PhoneSlot from '../components/PhoneSlot.astro';
import Footer from '../components/Footer.astro';
import Person from '../components/Person.astro';
---

<Base
  title="Comarket · Creator marketing, paid per sale"
  description="Brands pay creators only for completed sales. Creators get a co-branded storefront and earn on every sale and renewal. Free for creators."
  stage="fork"
  og="/og/og-fork.jpg"
>
  <main class="fork" data-fork>
    <header class="bar">
      <a class="wm" href="/?fork=1">Comarket</a>
    </header>

    <h1 class="display-l head" data-reveal>
      <span class="l1"><span>More sales for brands.</span> <span>More money for creators.</span></span>
      <span class="l2"><mark class="hl">One co-branded storefront.</mark></span>
    </h1>

    <div class="stagewrap" data-reveal style="--d:.12s">
      <PhoneSlot
        class="phone"
        poster="/assets/stage/poster-fork.webp"
        label="Example: one completed sale of a $49 product, split between the brand, the creator who sold it, and Comarket. Nobody paid anything before it."
      />
    </div>

    <a class="side brands" href="/brands" data-side="brands" data-astro-prefetch="load" data-reveal style="--d:.2s">
      <span class="who">Brands</span>
      <span class="what">Creators sell for you. You pay only when they make a sale.</span>
      <span class="go convert">Get creator sales <Icon name="arrow-right" class="arr" /></span>
    </a>
    <a class="side creators" href="/creators" data-side="creators" data-astro-prefetch="load" data-reveal style="--d:.26s">
      <span class="who">Creators</span>
      <span class="what">Get paid on every sale you send, every month it renews.</span>
      <span class="go convert">Start earning <Icon name="arrow-right" class="arr" /></span>
    </a>
  </main>

  <!-- a person on each side, looking in at the device. Side by side (.tall): a tall photo from under the wordmark's
       bar to the foot of the screen, off the outer edge, with the side's word, line and button on its lower part.
       Stacked (.wide): beside the phone. Outside the fork so the stage canvas draws over them; placed by the
       script. -->
  <div class="people" data-fork-people aria-hidden="true">
    <Person id="candle-maker" class="pp brands tall" decorative sizes="36vw" focal={[0.42, 0.34]} />
    <Person id="cook" class="pp creators tall" decorative sizes="30vw" focal={[0.62, 0.42]} />
    <Person id="florists" class="pp brands wide" decorative sizes="34vw" focal={[0.33, 0.24]} />
    <Person id="cook" class="pp creators wide" decorative sizes="34vw" focal={[0.46, 0.4]} />
  </div>

  <!-- for anyone who scrolls, and for search: what each side gets, in plain text -->
  <section class="about" aria-labelledby="about-h">
    <div class="wrap">
      <h2 class="about-h" id="about-h">Brands pay per sale. Creators never pay.</h2>
      <div class="cols">
        <div class="col">
          <h3 class="who-s">For brands</h3>
          <div class="pt">
            <h4>Pay only for completed sales.</h4>
            <p>Creators your buyers already follow send them to a storefront in your brand. You pay only when a new customer pays.</p>
          </div>
          <div class="pt">
            <h4>A storefront for every creator.</h4>
            <p>Your logo, colors and offer, with the creator’s name on top. Nothing to build.</p>
          </div>
          <a class="more" href="/brands">For brands <Icon name="arrow-right" class="arr" /></a>
        </div>
        <div class="col">
          <h3 class="who-s">For creators</h3>
          <div class="pt">
            <h4>Get paid on every sale.</h4>
            <p>Brands pitch you with the rate up front, and every renewal pays you again.</p>
          </div>
          <div class="pt">
            <h4>A page with your name on it.</h4>
            <p>comarket.si/yourname, free, always. Keep your link page and add it inside.</p>
          </div>
          <a class="more" href="/creators">For creators <Icon name="arrow-right" class="arr" /></a>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</Base>

<style>
  .fork {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    grid-template-areas:
      'bar bar bar'
      'head head head'
      'brands phone creators';
    column-gap: clamp(24px, 4vw, 72px);
    padding: 0 var(--gr) calc(28px + env(safe-area-inset-bottom, 0px)) var(--gl);
    /* the poster overhangs the phone sideways; never clip anything vertically */
    overflow-x: clip;
  }
  .bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    padding-top: calc(18px + env(safe-area-inset-top, 0px));
  }
  .wm {
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .head {
    grid-area: head;
    justify-self: center;
    text-align: center;
    margin-top: clamp(16px, 3.5vh, 44px);
    font-size: clamp(34px, 3.9vw, 62px);
    line-height: 1.16;
    max-width: 24ch;
  }
  .head > span {
    display: block;
  }
  /* one sentence per line, so the promise to each side reads as its own line */
  .l1 span {
    display: block;
  }
  .stagewrap {
    grid-area: phone;
    align-self: center;
    display: grid;
    place-items: center;
    min-height: 0;
    padding-block: clamp(20px, 4vh, 40px);
  }
  .stagewrap :global(.slot) {
    height: min(60vh, 580px);
    min-height: 300px;
  }
  /* A tablet, laptop or monitor (devices.ts) takes the device's shape, set before first paint by Base.astro, and
     fills its cell: the middle column is as wide as that device can have (--devw, per device below), the row is
     whatever height the headline leaves. There's no poster for them; the device fades up once it's drawn. */
  :global(html:not([data-device='phone'])) .fork {
    grid-template-columns: minmax(0, 1fr) var(--devw) minmax(0, 1fr);
  }
  :global(html:not([data-device='phone'])) .stagewrap {
    align-self: stretch;
    justify-self: stretch;
    container-type: size;
  }
  :global(html:not([data-device='phone'])) .stagewrap :global(.slot) {
    aspect-ratio: var(--device-aspect);
    height: auto;
    min-height: 0;
    width: min(100cqw, calc(100cqh * var(--device-aspect)));
  }
  :global(html:not([data-device='phone'])) .stagewrap :global(.poster) {
    display: none;
  }
  :global(html[data-device='tablet']) .fork {
    --devw: min(46vw, 640px);
  }
  :global(html[data-device='laptop']) .fork {
    --devw: min(50vw, 860px);
  }
  :global(html[data-device='monitor']) .fork {
    --devw: min(54vw, 1320px);
  }

  /* side by side, each side's word, line and button sit straight on the lower part of its photo, in paper over an
     ink fade rising from the photo's foot (under the faces), hugging the photo's inner edge. --pw is the photo's
     width (set by the script); --tw the text's. */
  .side {
    position: relative;
    z-index: 1;
    align-self: end;
    display: grid;
    gap: 14px;
    --tw: min(380px, calc(var(--pw, 400px) - var(--gl) - 32px));
    width: var(--tw);
    max-width: none;
    margin-bottom: clamp(28px, 6vh, 64px);
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.6s var(--ease);
  }
  /* paper on the photo's ink fade, once the photos are placed (before that, or without JS, it's ink on paper) */
  .fork.on-photos .side {
    color: var(--paper);
  }
  .side.brands {
    grid-area: brands;
    justify-self: start;
    margin-left: max(0px, calc(var(--pw, 400px) - var(--gl) - 32px - var(--tw)));
    text-align: right;
    justify-items: end;
  }
  .side.creators {
    grid-area: creators;
    justify-self: end;
    margin-right: max(0px, calc(var(--pw, 400px) - var(--gr) - 32px - var(--tw)));
  }
  .who {
    font-size: clamp(40px, 3.6vw, 80px);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  .fork.on-photos .who {
    text-shadow: 0 2px 18px rgb(20 9 44 / 0.45);
  }
  /* the people (placed by the script). They fade with the cards when a side is chosen. Both look inward, toward the
     device. */
  .people :global(.pp) {
    position: absolute;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .people :global(.pp.wide) {
    display: none;
  }
  .people.placed :global(.pp) {
    opacity: 1;
  }
  /* the ink fade the side's text sits on: from the photo's foot to just under the faces */
  .people :global(.pp.tall)::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    height: 58%;
    pointer-events: none;
    background: linear-gradient(to top, rgb(20 9 44 / 0.9) 0%, rgb(20 9 44 / 0.78) 34%, rgb(20 9 44 / 0.32) 70%, rgb(20 9 44 / 0));
  }
  /* pointing at a side: its photo leans in (a slow zoom inside the same box); the device keeps the shared view */
  .people :global(.pp.tall img) {
    transform-origin: 50% 36%;
    transition: transform 1.1s var(--ease);
  }
  .fork.on-brands ~ .people :global(.pp.tall.brands img),
  .fork.on-creators ~ .people :global(.pp.tall.creators img) {
    transform: scale(1.07);
  }
  @media (prefers-reduced-motion: reduce) {
    .people :global(.pp.tall img) {
      transition: none;
    }
  }
  .fork.flying ~ .people :global(.pp) {
    opacity: 0;
    transition: opacity 0.18s var(--ease);
  }
  .what {
    font-size: 18px;
    line-height: 1.45;
    min-height: 2.9em;
    color: var(--graphite);
    max-width: 24ch;
  }
  .fork.on-photos .what {
    color: rgb(255 247 236 / 0.92);
    text-shadow: 0 1px 10px rgb(20 9 44 / 0.5);
  }
  .go {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 24px;
    width: fit-content;
    border-radius: 999px;
    background: var(--blue);
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
    transition:
      background-color 0.35s var(--ease),
      transform 0.45s var(--ease);
  }
  .go .arr {
    transition: transform 0.45s var(--ease);
  }
  .side.on .go,
  .side:focus-visible .go {
    background: var(--blue-ink);
  }
  .side.on .go .arr {
    transform: translateX(4px);
  }
  .fork.leaning .side:not(.on) {
    opacity: 0.72;
  }
  /* a choice: the other card goes at once; the rest stays while the device goes to the page.
     .leaning is in the selector so this outranks the hover rules, which would otherwise keep the other card up */
  .fork.flying.leaning .side:not(.on) {
    opacity: 0;
    transform: none;
    transition: opacity 0.18s var(--ease);
  }

  .about {
    position: relative;
    z-index: 2;
    padding-block: clamp(72px, 10vw, 140px);
    border-top: 1px solid var(--rule);
  }
  .about-h {
    font-size: var(--fs-m);
    line-height: 1.1;
    letter-spacing: -0.04em;
    font-weight: 700;
    max-width: 20ch;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(32px, 4vw, 56px);
  }
  .col {
    display: grid;
    gap: 22px;
    align-content: start;
    justify-items: start;
  }
  .who-s {
    font-size: var(--fs-s);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pt {
    display: grid;
    gap: 6px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    width: 100%;
  }
  .pt h4 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .pt p {
    color: var(--graphite);
    line-height: 1.5;
    max-width: 46ch;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }


  /* phones and narrow tablets: headline, phone, then two plain choices */
  @media (max-width: 860px), (max-aspect-ratio: 4/5) {
    .fork {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        'bar bar'
        'head head'
        'phone phone'
        'brands creators';
      column-gap: 10px;
      row-gap: 12px;
    }
    .head {
      font-size: clamp(26px, 7.3vw, 44px);
      margin-top: 14px;
    }
    .stagewrap :global(.slot) {
      height: min(44svh, 420px);
      min-height: 240px;
    }
    :global(html:not([data-device='phone'])) .fork {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    :global(html:not([data-device='phone'])) .stagewrap {
      padding-block: clamp(16px, 2.6vh, 36px) clamp(10px, 1.6vh, 24px);
    }
    :global(html:not([data-device='phone'])) .stagewrap :global(.slot) {
      width: min(88cqw, calc(100cqh * var(--device-aspect)));
    }
    .stagewrap {
      padding-block: 8px;
    }
    .people :global(.pp.tall) {
      display: none;
    }
    .people :global(.pp.wide) {
      display: block;
    }
    .side,
    .side.brands,
    .side.creators {
      justify-self: stretch;
      justify-items: start;
      text-align: left;
      align-self: end;
      gap: 6px;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 16px 16px 16px;
      border-radius: 20px;
      background: var(--white);
      border: 1px solid var(--rule);
      box-shadow: none;
    }
    .fork.on-photos .side {
      color: var(--ink);
    }
    .side {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: 8px;
    }
    .side > :not(.who) {
      grid-column: 1 / -1;
    }
    .who {
      font-size: 26px;
      text-shadow: none;
    }
    .what {
      font-size: 13.5px;
      line-height: 1.35;
      min-height: 0;
      color: var(--graphite);
      text-shadow: none;
    }
    .go {
      height: auto;
      padding: 8px 0 0;
      background: none;
      color: inherit;
      font-size: 14.5px;
    }
    .side.on .go {
      background: none;
    }
    .side.brands.on,
    .side.creators.on {
      transform: none;
    }
    .fork.leaning .side:not(.on) {
      opacity: 1;
    }
  }
  @media (max-width: 360px) {
    .what {
      display: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { track } from '../scripts/ui';

  type Side = 'brands' | 'creators';
  let cleanup: (() => void) | null = null;

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-fork]');
    if (!root) return;
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('.side'));
    let current: Side | null = null;
    let chosen = false;
    const stacked = () => matchMedia('(max-width: 860px), (max-aspect-ratio: 4/5)').matches;

    const setHover = (s: Side | null) => {
      if (s === current || chosen) return;
      current = s;
      root.classList.toggle('leaning', !!s);
      root.classList.toggle('on-brands', s === 'brands');
      root.classList.toggle('on-creators', s === 'creators');
      root.style.cursor = s && !stacked() ? 'pointer' : '';
      links.forEach((l) => l.classList.toggle('on', l.dataset.side === s));
      dispatchEvent(new CustomEvent('stage:hover', { detail: s }));
    };

    /* the shared view is what most people see, so a side only previews when the pointer is at its card: over it, or
       within a short reach of it. Everywhere else, the device itself included, shows the shared sale */
    const REACH = 40;
    const sideAt = (x: number, y: number): Side | null => {
      if (stacked()) return null;
      for (const l of links) {
        const r = l.getBoundingClientRect();
        if (x > r.left - REACH && x < r.right + REACH && y > r.top - REACH && y < r.bottom + REACH) return l.dataset.side as Side;
        // the side's photo is its target too
        const ph = document.querySelector<HTMLElement>(`[data-fork-people] .pp.tall.${l.dataset.side}`)?.getBoundingClientRect();
        if (ph && ph.width && x > ph.left && x < ph.right && y > ph.top && y < ph.bottom) return l.dataset.side as Side;
      }
      return null;
    };

    const choose = (s: Side) => {
      if (chosen) return;
      setHover(s);
      chosen = true;
      // the other card clears; the rest of the fork stays put while the device goes to the page
      root.classList.add('flying');
      track('fork_choice', { side: s });
      let gone = false;
      const go = () => {
        if (gone) return;
        gone = true;
        navigate(`/${s}`);
      };
      dispatchEvent(new CustomEvent('stage:choose', { detail: { side: s, done: go } }));
      // in case the stage never answers
      setTimeout(go, 1500);
    };

    const onMove = (e: PointerEvent) => {
      if (e.pointerType === 'mouse') setHover(sideAt(e.clientX, e.clientY));
    };
    const onLeave = () => setHover(null);
    const onClick = (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.wm')) return;
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.side');
      const s = (link?.dataset.side as Side | undefined) ?? sideAt(e.clientX, e.clientY);
      if (!s) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      choose(s);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key.toLowerCase();
      if (k === 'b') choose('brands');
      if (k === 'c') choose('creators');
    };
    const onFocus = (e: FocusEvent) => setHover(((e.target as HTMLElement).closest<HTMLElement>('.side')?.dataset.side as Side) ?? null);
    links.forEach((l) => {
      l.addEventListener('focus', onFocus);
      l.addEventListener('blur', onLeave);
    });
    root.addEventListener('pointermove', onMove);
    root.addEventListener('pointerleave', onLeave);
    root.addEventListener('click', onClick);
    addEventListener('keydown', onKey);

    /* The people take the space the layout leaves: side by side, from just under the wordmark to the foot of the
       screen, and from the outer edge in to just short of the headline and the device (the card sits on the photo's
       lower part); stacked, the height of the phone, from each edge to just under the phone's side. */
    const people = document.querySelector<HTMLElement>('[data-fork-people]');
    const head = root.querySelector<HTMLElement>('.head');
    const slot = root.querySelector<HTMLElement>('.stagewrap .slot');
    const bar = root.querySelector<HTMLElement>('.bar');
    const place = () => {
      if (!people || !head || !slot) return;
      const vw = document.documentElement.clientWidth;
      const h = head.getBoundingClientRect();
      const sl = slot.getBoundingClientRect();
      const fork = root.getBoundingClientRect();
      for (const l of links) {
        const p = people.querySelector<HTMLElement>(`.pp.${stacked() ? 'wide' : 'tall'}.${l.dataset.side}`);
        if (!p) continue;
        const brands = l.dataset.side === 'brands';
        let top: number, height: number, width: number;
        if (stacked()) {
          top = sl.top + scrollY;
          height = sl.height;
          width = brands ? sl.left + 24 : vw - sl.right + 24;
        } else {
          top = (bar?.getBoundingClientRect().bottom ?? 0) + scrollY + 10;
          height = fork.bottom + scrollY - top;
          width = brands ? Math.min(h.left, sl.left) - 24 : vw - Math.max(h.right, sl.right) - 24;
        }
        // the side's text hugs the photo's inner edge
        l.style.setProperty('--pw', `${Math.max(0, width)}px`);
        Object.assign(p.style, {
          top: `${top}px`,
          height: `${Math.max(0, height)}px`,
          width: `${Math.max(0, width)}px`,
          left: brands ? '0px' : '',
          right: brands ? '' : '0px',
        });
      }
      people.classList.add('placed');
      root.classList.toggle('on-photos', !stacked());
    };
    const ro = new ResizeObserver(place);
    ro.observe(root);
    people?.querySelectorAll('img').forEach((i) => i.addEventListener('load', place, { once: true }));
    document.fonts?.ready.then(place);
    place();

    cleanup = () => {
      links.forEach((l) => {
        l.removeEventListener('focus', onFocus);
        l.removeEventListener('blur', onLeave);
      });
      root.removeEventListener('pointermove', onMove);
      root.removeEventListener('pointerleave', onLeave);
      root.removeEventListener('click', onClick);
      removeEventListener('keydown', onKey);
      ro.disconnect();
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
