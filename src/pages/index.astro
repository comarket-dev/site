---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import PhoneSlot from '../components/PhoneSlot.astro';
---

<Base
  title="Comarket · More sales for brands, more money for creators"
  description="One co-branded storefront: brands get more sales from creators and pay only when one completes, and creators earn more on every sale they send."
  stage="fork"
  og="/og/og-fork.jpg"
>
  <main class="fork" data-fork>
    <header class="bar">
      <a class="wm" href="/?fork=1">Comarket</a>
    </header>

    <h1 class="display-l head" data-reveal>
      <span class="l1"><span>More sales for brands.</span> <span>More money for creators.</span></span>
      <span class="l2"><mark class="hl">One co-branded storefront.</mark></span>
    </h1>

    <div class="stagewrap" data-reveal style="--d:.12s">
      <PhoneSlot
        class="phone"
        poster="/assets/stage/poster-fork.webp"
        label="Example: one completed sale of a $49 product, split between the brand, the creator who sold it, and Comarket. Nobody paid anything before it."
      />
    </div>

    <a class="side brands" href="/brands" data-side="brands" data-astro-prefetch="load" data-reveal style="--d:.2s">
      <span class="who">Brands</span>
      <span class="what">Creators sell for you. You pay only when they make a sale.</span>
      <span class="go">Get creator sales <Icon name="arrow-right" class="arr" /></span>
    </a>
    <a class="side creators" href="/creators" data-side="creators" data-astro-prefetch="load" data-reveal style="--d:.26s">
      <span class="who">Creators</span>
      <span class="what">Get paid on every sale you send, every month it renews.</span>
      <span class="go">Start earning <Icon name="arrow-right" class="arr" /></span>
    </a>
  </main>
</Base>

<style>
  .fork {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    grid-template-areas:
      'bar bar bar'
      'head head head'
      'brands phone creators';
    column-gap: clamp(24px, 4vw, 72px);
    padding: 0 var(--gr) calc(28px + env(safe-area-inset-bottom, 0px)) var(--gl);
    /* the poster overhangs the phone sideways; never clip anything vertically */
    overflow-x: clip;
  }
  .bar {
    grid-area: bar;
    display: flex;
    align-items: center;
    padding-top: calc(18px + env(safe-area-inset-top, 0px));
  }
  .wm {
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.04em;
    text-decoration: none;
  }
  .head {
    grid-area: head;
    justify-self: center;
    text-align: center;
    margin-top: clamp(16px, 3.5vh, 44px);
    font-size: clamp(34px, 3.9vw, 62px);
    line-height: 1.16;
    max-width: 24ch;
  }
  .head > span {
    display: block;
  }
  /* one sentence per line, so the promise to each side reads as its own line */
  .l1 span {
    display: block;
  }
  .stagewrap {
    grid-area: phone;
    align-self: center;
    display: grid;
    place-items: center;
    min-height: 0;
    padding-block: clamp(20px, 4vh, 40px);
  }
  .stagewrap :global(.slot) {
    height: min(60vh, 580px);
    min-height: 300px;
  }
  /* A tablet, laptop or monitor (devices.ts) takes the device's shape, set before first paint by Base.astro, and
     fills its cell: the middle column is as wide as that device can have (--devw, per device below), the row is
     whatever height the headline leaves. There's no poster for them; the device fades up once it's drawn. */
  :global(html:not([data-device='phone'])) .fork {
    grid-template-columns: minmax(0, 1fr) var(--devw) minmax(0, 1fr);
  }
  :global(html:not([data-device='phone'])) .stagewrap {
    align-self: stretch;
    justify-self: stretch;
    container-type: size;
  }
  :global(html:not([data-device='phone'])) .stagewrap :global(.slot) {
    aspect-ratio: var(--device-aspect);
    height: auto;
    min-height: 0;
    width: min(100cqw, calc(100cqh * var(--device-aspect)));
  }
  :global(html:not([data-device='phone'])) .stagewrap :global(.poster) {
    display: none;
  }
  :global(html[data-device='tablet']) .fork {
    --devw: min(46vw, 640px);
  }
  :global(html[data-device='laptop']) .fork {
    --devw: min(50vw, 860px);
  }
  :global(html[data-device='monitor']) .fork {
    --devw: min(54vw, 1320px);
  }

  .side {
    align-self: center;
    display: grid;
    gap: 16px;
    max-width: 360px;
    text-decoration: none;
    transition:
      opacity 0.6s var(--ease),
      transform 0.8s var(--ease);
  }
  .side.brands {
    grid-area: brands;
    justify-self: end;
    text-align: right;
    justify-items: end;
  }
  .side.creators {
    grid-area: creators;
    justify-self: start;
  }
  .who {
    font-size: clamp(44px, 5vw, 84px);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  .what {
    font-size: 18px;
    line-height: 1.45;
    min-height: 2.9em;
    color: var(--graphite);
    max-width: 24ch;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 52px;
    padding: 0 24px;
    width: fit-content;
    border-radius: 999px;
    background: var(--blue);
    color: var(--white);
    font-weight: 600;
    font-size: 16px;
    transition:
      background-color 0.35s var(--ease),
      transform 0.45s var(--ease);
  }
  .go .arr {
    transition: transform 0.45s var(--ease);
  }
  .side.on .go,
  .side:focus-visible .go {
    background: var(--blue-ink);
  }
  .side.on .go .arr {
    transform: translateX(4px);
  }
  .side.brands.on {
    transform: translateX(-8px);
  }
  .side.creators.on {
    transform: translateX(8px);
  }
  .fork.leaning .side:not(.on) {
    opacity: 0.3;
  }
  /* a choice: the other card goes at once; the rest stays while the device goes to the page.
     .leaning is in the selector so this outranks the hover rules, which would otherwise keep the other card up */
  .fork.flying.leaning .side:not(.on) {
    opacity: 0;
    transform: none;
    transition: opacity 0.18s var(--ease);
  }

  @media (hover: hover) {
    .fork {
      cursor: pointer;
    }
  }

  /* phones and narrow tablets: headline, phone, then two plain choices */
  @media (max-width: 860px), (max-aspect-ratio: 4/5) {
    .fork {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        'bar bar'
        'head head'
        'phone phone'
        'brands creators';
      column-gap: 10px;
      row-gap: 12px;
    }
    .head {
      font-size: clamp(26px, 7.3vw, 44px);
      margin-top: 14px;
    }
    .stagewrap :global(.slot) {
      height: min(44svh, 420px);
      min-height: 240px;
    }
    :global(html:not([data-device='phone'])) .fork {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    :global(html:not([data-device='phone'])) .stagewrap {
      padding-block: clamp(16px, 2.6vh, 36px) clamp(10px, 1.6vh, 24px);
    }
    :global(html:not([data-device='phone'])) .stagewrap :global(.slot) {
      width: min(88cqw, calc(100cqh * var(--device-aspect)));
    }
    .stagewrap {
      padding-block: 8px;
    }
    .side,
    .side.brands,
    .side.creators {
      justify-self: stretch;
      justify-items: start;
      text-align: left;
      align-self: end;
      gap: 6px;
      max-width: none;
      padding: 16px 16px 16px;
      border-radius: 20px;
      background: var(--white);
      border: 1px solid var(--rule);
    }
    .side.brands {
      background: var(--ink);
      color: var(--on-ink);
      border-color: var(--ink);
    }
    .side.brands .what {
      color: var(--on-ink-muted);
    }
    .who {
      font-size: 26px;
    }
    .what {
      font-size: 13.5px;
      line-height: 1.35;
      min-height: 0;
    }
    .go {
      height: auto;
      padding: 8px 0 0;
      background: none;
      color: inherit;
      font-size: 14.5px;
    }
    .side.on .go {
      background: none;
    }
    .side.brands.on,
    .side.creators.on {
      transform: none;
    }
    .fork.leaning .side:not(.on) {
      opacity: 1;
    }
  }
  @media (max-width: 360px) {
    .what {
      display: none;
    }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  import { track } from '../scripts/ui';

  type Side = 'brands' | 'creators';
  let cleanup: (() => void) | null = null;

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-fork]');
    if (!root) return;
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('.side'));
    let current: Side | null = null;
    let chosen = false;
    const stacked = () => matchMedia('(max-width: 860px), (max-aspect-ratio: 4/5)').matches;

    const setHover = (s: Side | null) => {
      if (s === current || chosen) return;
      current = s;
      root.classList.toggle('leaning', !!s);
      links.forEach((l) => l.classList.toggle('on', l.dataset.side === s));
      dispatchEvent(new CustomEvent('stage:hover', { detail: s }));
    };

    /* the shared view is what most people see, so a side only previews when the pointer is at its card: over it, or
       within a short reach of it. Everywhere else, the device itself included, shows the shared sale */
    const REACH = 40;
    const sideAt = (x: number, y: number): Side | null => {
      if (stacked()) return null;
      for (const l of links) {
        const r = l.getBoundingClientRect();
        if (x > r.left - REACH && x < r.right + REACH && y > r.top - REACH && y < r.bottom + REACH) return l.dataset.side as Side;
      }
      return null;
    };

    const choose = (s: Side) => {
      if (chosen) return;
      setHover(s);
      chosen = true;
      // the other card clears; the rest of the fork stays put while the device goes to the page
      root.classList.add('flying');
      track('fork_choice', { side: s });
      let gone = false;
      const go = () => {
        if (gone) return;
        gone = true;
        navigate(`/${s}`);
      };
      dispatchEvent(new CustomEvent('stage:choose', { detail: { side: s, done: go } }));
      // in case the stage never answers
      setTimeout(go, 1500);
    };

    const onMove = (e: PointerEvent) => {
      if (e.pointerType === 'mouse') setHover(sideAt(e.clientX, e.clientY));
    };
    const onLeave = () => setHover(null);
    const onClick = (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.wm')) return;
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.side');
      const s = (link?.dataset.side as Side | undefined) ?? sideAt(e.clientX, e.clientY);
      if (!s) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      choose(s);
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key.toLowerCase();
      if (k === 'b') choose('brands');
      if (k === 'c') choose('creators');
    };
    const onFocus = (e: FocusEvent) => setHover(((e.target as HTMLElement).closest<HTMLElement>('.side')?.dataset.side as Side) ?? null);
    links.forEach((l) => {
      l.addEventListener('focus', onFocus);
      l.addEventListener('blur', onLeave);
    });
    root.addEventListener('pointermove', onMove);
    root.addEventListener('pointerleave', onLeave);
    root.addEventListener('click', onClick);
    addEventListener('keydown', onKey);

    cleanup = () => {
      links.forEach((l) => {
        l.removeEventListener('focus', onFocus);
        l.removeEventListener('blur', onLeave);
      });
      root.removeEventListener('pointermove', onMove);
      root.removeEventListener('pointerleave', onLeave);
      root.removeEventListener('click', onClick);
      removeEventListener('keydown', onKey);
    };
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
