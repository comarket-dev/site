{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comarket-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Serves the apex domain. Cloudflare creates the DNS record and certificate.
  // www is redirected to the apex by a Redirect Rule in the dashboard.
  "routes": [{ "pattern": "comarket.si", "custom_domain": true }],

  // Caches experiment weights between requests. Create with:
  //   npx wrangler kv namespace create EXPERIMENTS
  "kv_namespaces": [{ "binding": "EXPERIMENTS", "id": "c469982b1e9f49999ad3f585b12d21dc" }],

  // Neon Postgres through Hyperdrive. Create with:
  //   npx wrangler hyperdrive create comarket --connection-string="<neon url>"
  // For local dev, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // or edit localConnectionString below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "44aa891f01e64b7d98f709d4a16444d9",
      "localConnectionString": "postgresql://comarket:comarket@localhost:5432/comarket"
    }
  ],

  "vars": {
    // "even" splits pricing traffic evenly. "bandit" turns on Thompson sampling.
    "PRICING_MODE": "even",
    // Cloudflare Turnstile site key. Leave empty to skip the bot check.
    "PUBLIC_TURNSTILE_SITE_KEY": "",
    // Sender for confirmation email, e.g. "Comarket <hello@comarket.si>". Empty skips email.
    "EMAIL_FROM": ""
  }
  // Secrets (wrangler secret put): RESEND_API_KEY, TURNSTILE_SECRET_KEY
}
